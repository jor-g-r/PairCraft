---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  /** From the image's provenance sidecar. */
  alt?: string;
  /** Shown when the image's licence requires a visible credit. */
  credit?: string;
}

const { image, alt = '', credit } = Astro.props;
---
<header class="relative isolate flex min-h-80 flex-col justify-end overflow-hidden bg-[#1e1e1e] px-[1.15rem] pb-6 pt-[1.4rem] text-on-photo shadow-[0_4px_4px_rgb(0_0_0/0.25)] md:min-h-96 md:p-8">
  {image && <Image src={image} alt={alt} class="absolute inset-0 -z-20 h-full w-full object-cover" widths={[640, 1024, 1600]} sizes="(min-width: 768px) 768px, 100vw" loading="eager" />}
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/70 to-black/30" aria-hidden="true"></div>
  {credit && <p class="absolute right-[0.9rem] top-[0.7rem] text-[0.625rem] font-light text-on-photo/70">{credit}</p>}
  <slot />
</header>
