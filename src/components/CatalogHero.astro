---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  /** From the image's provenance sidecar. */
  alt: string;
  credit?: string;
}

const { image, alt, credit } = Astro.props;
---
<section class="catalog-hero relative isolate flex aspect-[332/497] flex-col px-[1.15rem] pb-[1.3rem] pt-[2.45rem] text-on-photo shadow-[0_4px_4px_rgb(0_0_0/0.25)] sm:aspect-auto sm:min-h-[32rem] sm:px-10 sm:pb-8 sm:pt-16 lg:min-h-[36rem]">
  <div class="absolute inset-0 -z-10 overflow-hidden bg-black">
    <Image src={image} alt={alt} class="h-full w-full object-cover" widths={[400, 800, 1200, 1600]} sizes="(min-width: 1024px) 1024px, 100vw" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-black/65" aria-hidden="true"></div>
  </div>
  {credit && <p class="absolute right-[0.9rem] top-[0.7rem] text-[0.625rem] font-light text-on-photo/70">{credit}</p>}
  <div class="text-center"><slot name="head" /></div>
  <div class="mx-auto mt-[4.55rem] w-full max-w-xl sm:mt-14"><slot name="search" /></div>
  <div class="mx-auto mt-auto w-full max-w-xl pt-8"><slot name="foot" /></div>
</section>
