---
import { TIER_LABEL, type Tier } from '../lib/tier.ts';

interface Props {
  tier: Tier;
  class?: string;
}

const { tier, class: className = '' } = Astro.props;

const STYLES: Record<Tier, string> = {
  decisive: 'bg-[var(--color-accent)] text-white',
  'worth-trying': 'bg-neutral-100 text-neutral-900',
  risky: 'border border-neutral-300 text-neutral-700',
  skip: 'text-neutral-400',
};
---

<span
  class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium tracking-wide whitespace-nowrap ${STYLES[tier]} ${className}`}
  data-i18n-tier={tier}
>
  {TIER_LABEL[tier]}
</span>
