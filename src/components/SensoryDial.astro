---
interface Props { label: string; i18n: string; value: number; }
const { label, i18n, value } = Astro.props;
---
<div class="space-y-3">
  <div class="flex items-center justify-between gap-4 text-sm">
    <span data-i18n={i18n}>{label}</span>
    <span class="tabular-nums text-muted">{value}<span aria-hidden="true"> / 5</span><span class="sr-only" data-i18n="wine.outOf5">out of 5</span></span>
  </div>
  <div class="relative h-px bg-rule" aria-hidden="true">
    <span class="absolute inset-y-0 left-0 bg-ink" style={`width:${value * 20}%`}></span>
    <span class="absolute top-1/2 size-2.5 -translate-y-1/2 rounded-full bg-ink" style={`left:calc(${value * 20}% - ${value * 2}px)`}></span>
  </div>
</div>
