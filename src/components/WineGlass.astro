---
/**
 * Wine glass icon — visual differentiator for wine color and type.
 *
 * Two silhouettes: regular glass (red/white/rose/orange) and flute (sparkling).
 * Wine color is mapped to a fill that approximates the liquid color in glass.
 *
 * Use inline next to wine names where multiple wines appear side-by-side
 * (home grid, search dropdown). Outline uses currentColor so the icon
 * picks up its surrounding text color.
 */
type WineColor = 'red' | 'white' | 'rose' | 'orange' | 'sparkling';

interface Props {
  color: WineColor;
  /** Pixel size (rendered square). Defaults to 22. */
  size?: number;
  class?: string;
}

const { color, size = 22, class: className = '' } = Astro.props;

const FILL: Record<WineColor, string> = {
  red: 'var(--color-accent)',
  white: '#e8d97e',
  rose: '#e8a4a8',
  orange: '#cf7e2a',
  sparkling: '#e8d97e',
};

const isFlute = color === 'sparkling';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
  class={className}
>
  {
    isFlute ? (
      <>
        {/* Flute bowl outline */}
        <path
          d="M10 3 V15 C10 16 10.6 17 12 17 C13.4 17 14 16 14 15 V3 Z"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
        />
        {/* Wine fill (slightly inset) */}
        <path
          d="M11 5 V15 C11 15.5 11.3 16 12 16 C12.7 16 13 15.5 13 15 V5 Z"
          fill={FILL[color]}
        />
        {/* Stem */}
        <line
          x1="12"
          y1="17"
          x2="12"
          y2="20.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        {/* Base */}
        <line
          x1="9.5"
          y1="21"
          x2="14.5"
          y2="21"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      </>
    ) : (
      <>
        {/* Bowl outline */}
        <path
          d="M7 3 C7 11 9 14 12 14 C15 14 17 11 17 3 Z"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
        />
        {/* Wine fill (slightly inset) */}
        <path
          d="M8.6 6 C8.6 11 10 13 12 13 C14 13 15.4 11 15.4 6 Z"
          fill={FILL[color]}
        />
        {/* Stem */}
        <line
          x1="12"
          y1="14"
          x2="12"
          y2="20.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        {/* Base */}
        <line
          x1="9"
          y1="21"
          x2="15"
          y2="21"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      </>
    )
  }
</svg>
