---
import type { CollectionEntry } from 'astro:content';
import type { Tier } from '../lib/tier';
import TierBadge from './TierBadge.astro';
interface Props {
  dish: CollectionEntry<'dishes'>;
  wineId: string;
  tier: Tier;
  prose?: CollectionEntry<'pairings'>['data'];
}
const { dish, wineId, tier, prose } = Astro.props;
---
<a href={`/dish/${dish.id}?wine=${wineId}`} class="group block py-5">
  <TierBadge tier={tier} />
  <h4 class="mt-3 font-display text-xl font-semibold group-hover:underline" data-es-value={dish.data.nameEs}>{dish.data.name}</h4>
  <p class="mt-2 text-sm leading-relaxed text-muted" data-es-value={dish.data.descriptionEs}>{dish.data.description}</p>
  {prose && <p class="mt-3 font-display text-lg italic leading-snug" data-es-value={prose.explanationEs}>{prose.explanation}</p>}
</a>
