---
import Base from '../layouts/Base.astro';

const nextSteps = [
  { href: '/wines', key: 'nav.wines', label: 'Wines', note: 'Every bottle in the guide.', noteEs: 'Todas las botellas de la guía.' },
  { href: '/dishes', key: 'nav.dishes', label: 'Dishes', note: 'Start from the plate instead.', noteEs: 'Empieza por el plato.' },
  { href: '/pair', key: 'nav.pair', label: 'Find a pairing', note: 'Describe what you’re about to eat.', noteEs: 'Describe lo que vas a comer.' },
  { href: '/wine-style', key: 'nav.wineStyle', label: 'Find by wine style', note: 'Bottle not listed? Match its style.', noteEs: '¿Tu botella no aparece? Busca por su estilo.' },
];
---
<Base title="Page not found — Paircraft" description="This page isn’t in the guide.">
  <main class="page-shell max-w-3xl">
    <header>
      <h1 class="text-balance font-display text-[clamp(2.35rem,6.5vw,3.75rem)] font-normal leading-[1.1]"><span data-es-value="Esta página no está en la">This page isn’t on the</span> <em class="not-italic text-hero-accent" data-es-value="carta">list</em>.</h1>
      <p class="mt-[0.9rem] max-w-[36rem] text-[0.9375rem] font-light leading-[1.6] text-muted" data-es-value="Puede que el enlace haya envejecido mal, o que esa botella nunca estuviera en la bodega. Retoma desde algo que conocemos.">The link may have aged badly, or the bottle was never in the cellar. Pick up from something we know.</p>
      <a href="/" class="action mt-[1.3rem]" data-es-value="Volver a la guía">Back to the guide</a>
    </header>
    <nav class="mt-10" aria-labelledby="not-found-next">
      <h2 id="not-found-next" class="text-xs font-light text-muted" data-es-value="O ve directo a">Or go straight to</h2>
      <ul class="mt-3 border-t border-ink">
        {nextSteps.map((step) => (
          <li>
            <a href={step.href} class="group flex min-h-[3.4rem] items-center justify-between gap-4 border-b border-rule py-[0.8rem]">
              <span class="min-w-0">
                <span class="block font-display text-[1.15rem] leading-[1.3] group-hover:underline group-hover:underline-offset-4" data-i18n={step.key}>{step.label}</span>
                <span class="mt-[0.15rem] block text-[0.8125rem] font-light leading-[1.5] text-muted" data-es-value={step.noteEs}>{step.note}</span>
              </span>
              <svg class="h-4 w-4 shrink-0 text-muted transition-colors group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </main>
</Base>
