---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DishPairing from '../../components/DishPairing.astro';
import { Image } from 'astro:assets';
import WineGlass from '../../components/WineGlass.astro';
import WhereToBuy from '../../components/WhereToBuy.astro';
import SensoryDial from '../../components/SensoryDial.astro';
import { computeTier, dominantMode, type Tier } from '../../lib/tier';
import { regionImage } from '../../lib/region-images';
import { originLine, t } from '../../lib/i18n';

export async function getStaticPaths() {
  return (await getCollection('wines')).map((wine) => ({ params: { slug: wine.id }, props: { wine } }));
}
const { wine } = Astro.props;
const region = await getEntry(wine.data.region);
const fromRegion = region ? regionImage(region.id) : undefined;
const grapes = await Promise.all(wine.data.grapes.map(async (g) => ({ entry: await getEntry(g.grape), percentage: g.percentage })));
const dishes = await getCollection('dishes');
const explanations = new Map((await getCollection('pairings')).map((p) => [`${p.data.wine.id}__${p.data.dish.id}`, p.data]));
const tierOrder: Record<Tier, number> = { decisive: 0, 'worth-trying': 1, risky: 2, skip: 3 };
const results = dishes.filter((dish) => dish.data.format !== 'board').map((dish) => ({ dish, result: computeTier(wine.data, dish.data), prose: explanations.get(`${wine.id}__${dish.id}`) })).filter(({ prose }) => prose);
const boardGuides = (await Promise.all(dishes.filter((dish) => dish.data.format === 'board').map(async (board) => {
  const components = (await Promise.all(board.data.components.map(async (reference) => {
    const dish = await getEntry(reference);
    if (!dish) return undefined;
    return { dish, result: computeTier(wine.data, dish.data), prose: explanations.get(`${wine.id}__${dish.id}`) };
  }))).filter((component) => component !== undefined);
  return { board, components };
}))).filter(({ components }) => components.some(({ prose, result }) => prose && result.tier !== 'skip'));
const feeds = (['meal', 'snack'] as const).map((occasion) => ({
  occasion,
  entries: results.filter(({ dish, result }) => dish.data.occasion.includes(occasion) && result.tier !== 'skip').sort((a,b) => tierOrder[a.result.tier] - tierOrder[b.result.tier]),
  groups: (['harmony', 'contrast', 'enhancement'] as const).map((mode) => ({ mode, entries: results.filter(({ dish, result }) => dish.data.occasion.includes(occasion) && result.tier !== 'skip' && dominantMode(result.activations) === mode).sort((a,b) => tierOrder[a.result.tier] - tierOrder[b.result.tier]) })).filter((g) => g.entries.length),
}));
const groupGrid = ['', 'max-w-2xl', 'lg:grid-cols-2', 'lg:grid-cols-3'];
const profile = wine.data.sensoryProfile;
const bodyKey = profile.body <= 2 ? 'wine.light' : profile.body === 3 ? 'wine.medium' : 'wine.full';
const tanninKey = profile.tannin === 0 ? 'wine.absent' : profile.tannin <= 2 ? 'wine.soft' : profile.tannin === 3 ? 'wine.medium' : 'wine.firm';
// Style guidance is explicitly labelled; it is not a claimed bottle-specific fact.
const suggestedTemperature = wine.data.color === 'sparkling' ? [6, 8] : wine.data.color === 'red' ? (profile.body <= 2 ? [12, 14] : [15, 18]) : [8, 12];
const temperature = wine.data.servingTemperature ? [wine.data.servingTemperature.minC, wine.data.servingTemperature.maxC] : suggestedTemperature;
const notes = ['primary', 'secondary', 'tertiary'] as const;
const tanninAxes = ['softness', 'astringency', 'complexity', 'structure', 'firmness'] as const;
// Where the bottle is sold: market names plus the retailer behind the listing, named from the markets' retailer list.
const markets = await getCollection('markets');
const soldIn = markets.filter((market) => wine.data.markets.includes(market.data.code));
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const listingUrl = wine.data.availability?.sourceUrl;
const retailer = listingUrl ? markets.flatMap((market) => market.data.retailers).find((r) => r.url && hostOf(r.url) === hostOf(listingUrl))?.name : undefined;
---
<Base title={`${wine.data.name} — Paircraft`} description={wine.data.tagline}>
  <main class="page-shell">
    <a href="/wines" data-catalog-return class="editorial-link text-muted" data-i18n="wine.back">All wines</a>
    <div class="wine-intro">
      <header>
        <WineGlass color={wine.data.color} class="mt-6 h-10 w-10 text-ink" />
        <h1 class="mt-4 text-balance font-display text-[clamp(2.35rem,6.5vw,4rem)] font-normal leading-[1.1]">{wine.data.name}{wine.data.vintage && <span> {wine.data.vintage}</span>}</h1>
        <p class="mt-[0.8rem] max-w-[36rem] font-display text-[1.15rem] italic leading-[1.5] text-muted" data-es-value={wine.data.taglineEs}>{wine.data.tagline}</p>
        <p class="mt-[0.5rem] text-[0.8125rem] font-light [&_a]:inline-block [&_a]:py-[0.3rem] [&_a]:underline [&_a]:underline-offset-[0.2em]">
          {region && <a href={`/region/${region.id}`} data-es-value={originLine(region.data).es}>{originLine(region.data).en}</a>}
          {grapes.map(({ entry, percentage }) => entry && <><span aria-hidden="true"> · </span><a href={`/grape/${entry.id}`} data-es-value={entry.data.nameEs && `${entry.data.nameEs}${percentage != null && grapes.length > 1 ? ` ${percentage}%` : ''}`}>{entry.data.name}{percentage != null && grapes.length > 1 ? ` ${percentage}%` : ''}</a></>)}
        </p>
        <nav class="tile-shadow mt-6 grid grid-cols-2 bg-surface" aria-label="Choose a pairing occasion">
          <a href={`?occasion=meal#pairings`} class="flex min-h-12 items-center justify-center text-xs uppercase tracking-[0.04em] transition-colors hover:bg-accent hover:text-on-accent" data-i18n="wine.forMeal">For a meal</a>
          <a href={`?occasion=snack#pairings`} class="flex min-h-12 items-center justify-center border-l border-rule text-xs uppercase tracking-[0.04em] transition-colors hover:bg-accent hover:text-on-accent" data-i18n="wine.forSnack">For a snack</a>
        </nav>
      </header>
      <div class="mt-9 grid gap-8 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] md:items-start md:gap-12">
        <section aria-labelledby="wine-sheet-title">
          <h2 id="wine-sheet-title" class="font-display text-2xl font-normal" data-i18n="wine.sheet">On the sheet</h2>
          <dl class="spec-list mt-3">
            <div><dt data-i18n="wine.temperature">Serve at</dt><dd>{temperature[0]}–{temperature[1]} °C<small>{Math.round(temperature[0] * 9/5 + 32)}–{Math.round(temperature[1] * 9/5 + 32)} °F</small>{!wine.data.servingTemperature && <span class="block text-[0.6875rem] font-light text-muted" data-i18n="wine.temperatureGuide">Style guide</span>}</dd></div>
            <div><dt data-i18n="wine.body">Body</dt><dd><span data-i18n={bodyKey}>{t(bodyKey)}</span></dd></div>
            <div><dt data-i18n="wine.tannin">Tannin</dt><dd><span data-i18n={tanninKey}>{t(tanninKey)}</span></dd></div>
            <div><dt data-i18n={wine.data.aftertaste ? 'wine.aftertaste' : 'wine.primaryNotes'}>{wine.data.aftertaste ? 'Finish' : 'Primary notes'}</dt><dd>{wine.data.aftertaste ? <span data-es-value={wine.data.aftertasteEs}>{wine.data.aftertaste}</span> : wine.data.flavouring?.primary.length ? <span data-es-value={wine.data.flavouringEs?.primary.length ? wine.data.flavouringEs.primary.slice(0,2).join(' · ') : undefined}>{wine.data.flavouring.primary.slice(0,2).join(' · ')}</span> : <span class="font-sans text-[0.8125rem] font-light text-muted" data-i18n="wine.notRecorded">Not yet recorded</span>}</dd></div>
          </dl>
          {/* Sweetness and acidity are independent; neither is the opposite of the other. */}
          <div class="mt-5 grid gap-5">
            <SensoryDial label="Sweetness" i18n="wine.sweetness" value={profile.sweetness} />
            <SensoryDial label="Acidity" i18n="wine.acidity" value={profile.acidity} />
          </div>
        </section>
        <WhereToBuy color={wine.data.color} soldIn={soldIn} listingUrl={listingUrl} retailer={retailer} />
      </div>
    </div>

    <section id="pairings" class="mt-16 md:mt-20">
      <h2 class="section-title" data-i18n="wine.pairings">Pairings</h2>
      <nav class="mt-5 flex gap-[0.6rem]" aria-label="Choose a pairing occasion">
        <a href="?occasion=meal#pairings" class="type-pill h-[2.1rem] px-4" data-occasion-link="meal" data-i18n="wine.mealPairings">With a meal</a>
        <a href="?occasion=snack#pairings" class="type-pill h-[2.1rem] px-4" data-occasion-link="snack" data-i18n="wine.snackPairings">For a snack</a>
      </nav>
      {feeds.map(({ occasion, entries, groups }) => <div class="mt-7" data-occasion-feed={occasion} hidden>
        {occasion === 'snack' ? <section>
          <h3 class="font-display text-[1.45rem] font-normal italic leading-[1.2]" data-i18n="wine.snackSuggestions">Bites for this wine</h3>
          {entries.length ? <ul class="mt-4 grid gap-3 lg:grid-cols-3">{entries.map(({ dish, result, prose }) => <li><DishPairing dish={dish} wineId={wine.id} occasion="snack" tier={result.tier} prose={prose} /></li>)}</ul> : <p class="mt-4 text-sm font-light text-muted" data-i18n="wine.noOccasionPairings">No pairings for this occasion have been curated yet.</p>}
        </section> : <>
          {!groups.length && <p class="text-sm font-light text-muted" data-i18n="wine.noOccasionPairings">No pairings for this occasion have been curated yet.</p>}
          <div class={`grid items-start gap-10 lg:gap-6 ${groupGrid[groups.length]}`}>
            {groups.map(({ mode, entries }) => <section>
              <h3 class="font-display text-[1.45rem] font-normal italic leading-[1.2]" data-i18n={`mode.${mode}`}>{t(`mode.${mode}`)}</h3>
              <p class="mt-[0.35rem] text-[0.8125rem] font-light text-muted" data-i18n={`mode.${mode}Hint`}>{t(`mode.${mode}Hint`)}</p>
              <ul class="mt-4 grid gap-3">
                {entries.slice(0, 3).map(({ dish, result, prose }) => <li><DishPairing dish={dish} wineId={wine.id} occasion="meal" tier={result.tier} prose={prose} /></li>)}
              </ul>
              {entries.length > 3 && <details class="mt-2"><summary class="min-h-11 cursor-pointer text-[0.8125rem] font-semibold" data-es-value={entries.length - 3 === 1 ? 'Ver 1 maridaje más' : `Ver ${entries.length - 3} maridajes más`}>{entries.length - 3 === 1 ? 'View 1 more pairing' : `View ${entries.length - 3} more pairings`}</summary><ul class="mt-1 grid gap-3">{entries.slice(3).map(({ dish, result, prose }) => <li><DishPairing dish={dish} wineId={wine.id} occasion="meal" tier={result.tier} prose={prose} /></li>)}</ul></details>}
            </section>)}
          </div>
        </>}
        {occasion === 'snack' && boardGuides.length > 0 && <section class="mt-12">
          <h3 class="section-title" data-i18n="wine.guidedBoards">Build a cheese board</h3>
          <p class="mt-[0.35rem] text-[0.8125rem] font-light text-muted" data-i18n="wine.guidedBoardsNote">Each cheese keeps its own pairing; the board itself receives no averaged verdict.</p>
          {boardGuides.map(({ board, components }) => {
            const recommendedCount = components.filter(({ prose, result }) => prose && result.tier !== 'skip').length;
            return <article class="mt-6">
              <h4 class="font-display text-[1.3rem] font-normal" data-es-value={board.data.nameEs}>{board.data.name}</h4>
              <p class="mt-[0.35rem] text-sm font-light leading-[1.55] text-muted" data-es-value={board.data.descriptionEs}>{board.data.description}</p>
              <p class="mt-2 text-xs font-light text-muted" data-es-value={`Maridajes recomendados para ${recommendedCount} de ${components.length} componentes.`}>Recommended pairings for {recommendedCount} of {components.length} components.</p>
              <ul class="mt-4 grid gap-3 lg:grid-cols-3">
                {components.map(({ dish, result, prose }) => <li>
                  {prose && result.tier !== 'skip' ? <DishPairing dish={dish} wineId={wine.id} occasion="snack" tier={result.tier} prose={prose} /> : <a href={`/dish/${dish.id}?wine=${wine.id}&occasion=snack`} class="tile-shadow group block h-full bg-surface px-[1.15rem] pb-5 pt-[1.1rem]">
                    <h5 class="font-display text-[1.3rem] font-normal leading-[1.2] group-hover:underline" data-es-value={dish.data.nameEs}>{dish.data.name}</h5>
                    <span class="mt-[0.4rem] inline-block text-[0.8125rem] font-light text-muted underline underline-offset-[0.2em]" data-i18n="wine.componentBetterElsewhere">Better with another wine</span>
                  </a>}
                </li>)}
              </ul>
            </article>;
          })}
        </section>}
      </div>)}
    </section>

    <section class="mt-16">
      <div class="relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden bg-[#1e1e1e] px-[1.15rem] pb-[1.4rem] pt-5 text-on-photo shadow-[0_4px_4px_rgb(0_0_0/0.25)] md:min-h-[30rem] md:p-8">
        {fromRegion && <Image src={fromRegion.image} alt={fromRegion.alt ?? ''} class="absolute inset-0 -z-20 h-full w-full object-cover" widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 1024px, 100vw" />}
        <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 to-black/15" aria-hidden="true"></div>
        {fromRegion?.creditLine && <span class="absolute right-[0.9rem] top-[0.7rem] text-[0.625rem] font-light text-on-photo/70">{fromRegion.creditLine}</span>}
        <h2 class="font-display text-[1.9rem] font-normal" data-i18n="wine.character">In the glass</h2>
        <p class="mt-[0.7rem] max-w-[38rem] text-[0.9375rem] font-light leading-[1.7]" data-es-value={wine.data.summaryEs}>{wine.data.summary}</p>
        {region && <a href={`/region/${region.id}`} class="relative mt-[0.9rem] self-start text-xs font-light underline underline-offset-[0.2em] after:absolute after:-inset-x-[0.3rem] after:-inset-y-3 after:content-['']" data-es-value={`De ${region.data.nameEs ?? region.data.name}`}>{`From ${region.data.name}`}</a>}
      </div>
      {wine.data.pedagogicalRole && <details class="mt-5 border-t border-rule"><summary class="min-h-11 cursor-pointer text-[0.8125rem] font-semibold" data-i18n="wine.teachingNote">Teaching note</summary><p class="pb-[0.9rem] text-sm font-light leading-[1.6] text-muted" data-es-value={wine.data.pedagogicalRoleEs}>{wine.data.pedagogicalRole}</p></details>}
      <dl class="spec-list mt-5">
        <div><dt data-i18n="wine.colour">Colour</dt><dd data-i18n={`color.${wine.data.color}`}>{t(`color.${wine.data.color}`)}</dd></div>
        {wine.data.style && <div><dt data-i18n="catalog.style">Style</dt><dd data-es-value={wine.data.styleEs}>{wine.data.style}</dd></div>}
      </dl>
    </section>

    {wine.data.flavouring && notes.some((key) => wine.data.flavouring?.[key]?.length) && <section class="mt-14">
      <h2 class="section-title" data-i18n="wine.flavouring">Flavour notes</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-3">
        {notes.map((key) => wine.data.flavouring?.[key]?.length ? <div><dt class="text-[0.6875rem] uppercase tracking-[0.06em] text-muted" data-i18n={`wine.${key}Notes`}>{t(`wine.${key}Notes`)}</dt><dd class="mt-[0.4rem] font-display text-[1.5rem] leading-[1.25]" data-es-value={wine.data.flavouringEs?.[key]?.length ? wine.data.flavouringEs[key].join(' · ') : undefined}>{wine.data.flavouring[key].join(' · ')}</dd></div> : null)}
      </dl>
    </section>}

    {wine.data.tanninProfile && <section class="mt-14">
      <h2 class="section-title" data-i18n="wine.tanninDetail">A closer look at tannins</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">{tanninAxes.map((key) => {
        const value = wine.data.tanninProfile?.[key];
        return value != null && <SensoryDial label={t(`wine.${key}`)} i18n={`wine.${key}`} value={value} />;
      })}</div>
    </section>}

    {wine.data.recommendedPairings.length > 0 && <section class="mt-11">
      <h2 class="mb-[0.7rem] font-display text-[1.3rem] font-normal italic" data-i18n="wine.quickHints">Quick hints</h2>
      <ul class="flex flex-wrap gap-[0.45rem]">{wine.data.recommendedPairings.map((hint, i) => <li class="tag-pill border-ink" data-es-value={wine.data.recommendedPairingsEs[i]}>{hint}</li>)}</ul>
    </section>}
    <a href="/wines" data-catalog-return class="editorial-link mt-10" data-i18n="wine.back">All wines</a>
  </main>
</Base>
<script>
  function initPairingOccasion() {
    const feeds = [...document.querySelectorAll<HTMLElement>('[data-occasion-feed]')];
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-occasion-link]')];
    if (!feeds.length || !links.length) return;
    const select = (occasion: string, updateUrl = false) => {
      const selected = occasion === 'snack' ? 'snack' : 'meal';
      feeds.forEach((feed) => { feed.hidden = feed.dataset.occasionFeed !== selected; });
      links.forEach((link) => {
        const active = link.dataset.occasionLink === selected;
        link.setAttribute('aria-current', active ? 'page' : 'false');
      });
      if (updateUrl) {
        const url = new URL(location.href);
        url.searchParams.set('occasion', selected);
        url.hash = 'pairings';
        history.replaceState(history.state, '', url);
      }
    };
    links.forEach((link) => link.addEventListener('click', (event) => {
      event.preventDefault();
      select(link.dataset.occasionLink ?? 'meal', true);
    }));
    select(new URLSearchParams(location.search).get('occasion') ?? 'meal');
    if (location.hash === '#pairings') {
      requestAnimationFrame(() => requestAnimationFrame(() => document.querySelector('#pairings')?.scrollIntoView({ block: 'start' })));
    }
  }
  document.addEventListener('astro:page-load', initPairingOccasion);
  initPairingOccasion();
</script>
