---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { computeTier, type Tier } from '../../lib/tier.ts';
import type { Mode } from '../../lib/rules.ts';
import TierBadge from '../../components/TierBadge.astro';

export async function getStaticPaths() {
  const wines = await getCollection('wines');
  return wines.map((wine) => ({ params: { slug: wine.id }, props: { wine } }));
}

const { wine } = Astro.props;
const region = await getEntry(wine.data.region);
const grapes = await Promise.all(
  wine.data.grapes.map(async (g) => ({
    entry: await getEntry(g.grape),
    percentage: g.percentage,
  })),
);

const allDishes = await getCollection('dishes');
const allPairings = await getCollection('pairings');
const pairingMap = new Map(
  allPairings.map((p) => [`${p.data.wine.id}__${p.data.dish.id}`, p.data.explanation]),
);

const MODES: readonly Mode[] = ['harmony', 'contrast', 'enhancement'] as const;
const MODE_LABEL: Record<Mode, string> = {
  harmony: 'by Harmony',
  contrast: 'by Contrast',
  enhancement: 'by Enhancement',
};
const TIER_ORDER: Record<Tier, number> = {
  decisive: 0,
  'worth-trying': 1,
  risky: 2,
  skip: 3,
};

const dishResults = allDishes.map((dish) => ({
  dish,
  result: computeTier(wine.data, dish.data),
  explanation: pairingMap.get(`${wine.id}__${dish.id}`),
}));

const pairingsByMode = MODES.map((mode) => ({
  mode,
  entries: dishResults
    .filter(
      ({ result }) =>
        result.tier !== 'skip' && result.activations.some((r) => r.mode === mode),
    )
    .sort((a, b) => TIER_ORDER[a.result.tier] - TIER_ORDER[b.result.tier]),
}));

const SENSORY_AXES = [
  { key: 'sweetness', label: 'Sweetness' },
  { key: 'acidity', label: 'Acidity' },
  { key: 'tannin', label: 'Tannin' },
  { key: 'body', label: 'Body' },
] as const;
---

<Base
  title={`${wine.data.name}${wine.data.vintage ? ` ${wine.data.vintage}` : ''} — Paircraft`}
  description={wine.data.tagline}
>
  <main class="mx-auto max-w-2xl px-6 py-10 md:py-16">
    {
      region && (
        <p class="text-sm text-neutral-500">
          <a href={`/region/${region.id}`} class="hover:text-neutral-900 hover:underline">
            {region.data.name}, {region.data.country}
          </a>
        </p>
      )
    }

    <header class="mt-2">
      <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight">
        {wine.data.name}
        {wine.data.vintage && <span class="font-normal text-neutral-500"> {wine.data.vintage}</span>}
      </h1>
      <p class="mt-2 font-display text-lg italic text-neutral-700">{wine.data.tagline}</p>
      {
        wine.data.style && (
          <p class="mt-3">
            <span class="inline-block rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs uppercase tracking-wider text-neutral-600">
              {wine.data.style}
            </span>
          </p>
        )
      }
    </header>

    <p class="mt-6 text-neutral-800 leading-relaxed">{wine.data.summary}</p>

    {
      wine.data.pedagogicalRole && (
        <p class="mt-4 border-l-2 border-neutral-300 pl-4 text-sm italic text-neutral-600 leading-relaxed">
          <span class="block text-[10px] uppercase tracking-widest not-italic text-neutral-400 mb-1">
            Teaching note
          </span>
          {wine.data.pedagogicalRole}
        </p>
      )
    }

    {
      wine.data.availability && (
        <section class="mt-8 rounded-lg border border-neutral-200 bg-neutral-50 px-5 py-4">
          <p class="text-[10px] uppercase tracking-widest text-neutral-500">
            Where to find it
          </p>
          <p class="mt-1.5 text-sm text-neutral-800">{wine.data.availability.note}</p>
          {
            wine.data.availability.sourceUrl && (
              <a
                href={wine.data.availability.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1.5 rounded-md border border-neutral-900 bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-neutral-800 transition"
              >
                <span>View listing</span>
                <svg
                  class="h-3.5 w-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            )
          }
        </section>
      )
    }

    <dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-neutral-500">Colour</dt>
      <dd class="capitalize">{wine.data.color}</dd>
      <dt class="text-neutral-500">Grapes</dt>
      <dd>
        {
          grapes.map((g, i) => (
            <>
              {g.entry && (
                <a href={`/grape/${g.entry.id}`} class="hover:underline">
                  {g.entry.data.name}
                </a>
              )}
              {g.percentage != null && grapes.length > 1 && (
                <span class="text-neutral-500"> ({g.percentage}%)</span>
              )}
              {i < grapes.length - 1 && <span>, </span>}
            </>
          ))
        }
      </dd>
    </dl>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold">Sensory profile</h2>
      <dl class="mt-4 space-y-3">
        {
          SENSORY_AXES.map(({ key, label }) => {
            const value = wine.data.sensoryProfile[key];
            return (
              <div class="flex items-center gap-4">
                <dt class="w-24 text-sm text-neutral-600">{label}</dt>
                <dd class="flex flex-1 gap-1">
                  {[1, 2, 3, 4, 5].map((step) => (
                    <span
                      class={`h-2 flex-1 rounded-full ${
                        step <= value ? 'bg-neutral-900' : 'bg-neutral-200'
                      }`}
                      aria-hidden="true"
                    />
                  ))}
                  <span class="sr-only">{value} out of 5</span>
                </dd>
              </div>
            );
          })
        }
      </dl>
    </section>

    {
      wine.data.recommendedPairings && wine.data.recommendedPairings.length > 0 && (
        <section class="mt-12">
          <p class="text-[10px] uppercase tracking-widest text-neutral-500">Quick hints</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {wine.data.recommendedPairings.map((hint) => (
              <li class="inline-block rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs text-neutral-600 capitalize">
                {hint}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold">Pairings</h2>
      {
        pairingsByMode.every(({ entries }) => entries.length === 0) && (
          <p class="mt-4 text-neutral-500">No matching dishes seeded yet.</p>
        )
      }
      {
        pairingsByMode.map(({ mode, entries }) =>
          entries.length === 0 ? null : (
            <div class="mt-8">
              <h3 class="font-display text-xl italic text-neutral-800">{MODE_LABEL[mode]}</h3>
              <ul class="mt-3 space-y-3">
                {entries.map(({ dish, result, explanation }) => (
                  <li>
                    <a
                      href={`/dish/${dish.id}`}
                      class="block rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 transition hover:border-neutral-400 hover:bg-white"
                    >
                      <div class="flex items-baseline justify-between gap-4">
                        <p class="font-display text-lg font-semibold">{dish.data.name}</p>
                        <TierBadge tier={result.tier} class="shrink-0" />
                      </div>
                      <p class="mt-1 text-sm text-neutral-600">{dish.data.description}</p>
                      {explanation && (
                        <p class="mt-2 font-display text-base italic text-neutral-800 leading-snug">
                          {explanation}
                        </p>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ),
        )
      }
    </section>
  </main>
</Base>
