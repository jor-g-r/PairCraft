---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DishPairing from '../../components/DishPairing.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import WineGlass from '../../components/WineGlass.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import SensoryDial from '../../components/SensoryDial.astro';
import { computeTier, dominantMode, type Tier } from '../../lib/tier';
import { regionImage } from '../../lib/region-images';
import { originLine, t } from '../../lib/i18n';

export async function getStaticPaths() {
  return (await getCollection('wines')).map((wine) => ({ params: { slug: wine.id }, props: { wine } }));
}
const { wine } = Astro.props;
const region = await getEntry(wine.data.region);
const fromRegion = region ? regionImage(region.id) : undefined;
const grapes = await Promise.all(wine.data.grapes.map(async (g) => ({ entry: await getEntry(g.grape), percentage: g.percentage })));
const dishes = await getCollection('dishes');
const explanations = new Map((await getCollection('pairings')).map((p) => [`${p.data.wine.id}__${p.data.dish.id}`, p.data]));
const tierOrder: Record<Tier, number> = { decisive: 0, 'worth-trying': 1, risky: 2, skip: 3 };
const results = dishes.filter((dish) => dish.data.format !== 'board').map((dish) => ({ dish, result: computeTier(wine.data, dish.data), prose: explanations.get(`${wine.id}__${dish.id}`) })).filter(({ prose }) => prose);
const boardGuides = (await Promise.all(dishes.filter((dish) => dish.data.format === 'board').map(async (board) => {
  const components = (await Promise.all(board.data.components.map(async (reference) => {
    const dish = await getEntry(reference);
    if (!dish) return undefined;
    return { dish, result: computeTier(wine.data, dish.data), prose: explanations.get(`${wine.id}__${dish.id}`) };
  }))).filter((component) => component !== undefined);
  return { board, components };
}))).filter(({ components }) => components.some(({ prose, result }) => prose && result.tier !== 'skip'));
const feeds = (['meal', 'snack'] as const).map((occasion) => ({
  occasion,
  entries: results.filter(({ dish, result }) => dish.data.occasion.includes(occasion) && result.tier !== 'skip').sort((a,b) => tierOrder[a.result.tier] - tierOrder[b.result.tier]),
  groups: (['harmony', 'contrast', 'enhancement'] as const).map((mode) => ({ mode, entries: results.filter(({ dish, result }) => dish.data.occasion.includes(occasion) && result.tier !== 'skip' && dominantMode(result.activations) === mode).sort((a,b) => tierOrder[a.result.tier] - tierOrder[b.result.tier]) })).filter((g) => g.entries.length),
}));
const groupGrid = ['', 'max-w-2xl', 'lg:grid-cols-2', 'lg:grid-cols-3'];
const profile = wine.data.sensoryProfile;
const bodyKey = profile.body <= 2 ? 'wine.light' : profile.body === 3 ? 'wine.medium' : 'wine.full';
const tanninKey = profile.tannin === 0 ? 'wine.absent' : profile.tannin <= 2 ? 'wine.soft' : profile.tannin === 3 ? 'wine.medium' : 'wine.firm';
// Style guidance is explicitly labelled; it is not a claimed bottle-specific fact.
const suggestedTemperature = wine.data.color === 'sparkling' ? [6, 8] : wine.data.color === 'red' ? (profile.body <= 2 ? [12, 14] : [15, 18]) : [8, 12];
const temperature = wine.data.servingTemperature ? [wine.data.servingTemperature.minC, wine.data.servingTemperature.maxC] : suggestedTemperature;
const notes = ['primary', 'secondary', 'tertiary'] as const;
const tanninAxes = ['softness', 'astringency', 'complexity', 'structure', 'firmness'] as const;
---
<Base title={`${wine.data.name} — Paircraft`} description={wine.data.tagline}>
  <main class="page-shell">
    <a href="/wines" data-catalog-return class="editorial-link text-muted" data-i18n="wine.back">All wines</a>
    <header class="mx-auto mt-4 max-w-3xl text-center">
      <WineGlass color={wine.data.color} class="mx-auto mb-5 h-16 w-16 text-ink" />
      <h1 class="font-display text-[clamp(2.5rem,7vw,5.5rem)] font-bold leading-[1.05] tracking-[-0.03em]">{wine.data.name}{wine.data.vintage && <span class="font-normal"> {wine.data.vintage}</span>}</h1>
      <p class="mx-auto mt-5 max-w-xl font-display text-xl italic leading-relaxed text-muted sm:text-2xl" data-es-value={wine.data.taglineEs}>{wine.data.tagline}</p>
      <p class="mt-5 text-sm text-muted">
        {region && <a href={`/region/${region.id}`} class="underline hover:text-ink" data-es-value={originLine(region.data).es}>{originLine(region.data).en}</a>}
        {grapes.map(({ entry, percentage }) => entry && <><span aria-hidden="true"> · </span><a href={`/grape/${entry.id}`} class="underline hover:text-ink" data-es-value={entry.data.nameEs && `${entry.data.nameEs}${percentage != null && grapes.length > 1 ? ` ${percentage}%` : ''}`}>{entry.data.name}{percentage != null && grapes.length > 1 ? ` ${percentage}%` : ''}</a></>)}
      </p>
      <nav class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="Choose a pairing occasion">
        <a href={`?occasion=meal#pairings`} class="action" data-i18n="wine.forMeal">For a meal</a>
        <a href={`?occasion=snack#pairings`} class="action" data-i18n="wine.forSnack">For a snack</a>
      </nav>
    </header>

    <section class="mx-auto mt-10 max-w-3xl" aria-label="Sensory profile">
      <!-- Sweetness and acidity are independent; neither is the opposite of the other. -->
      <div class="grid gap-7 sm:grid-cols-2">
        <SensoryDial label="Sweetness" i18n="wine.sweetness" value={profile.sweetness} />
        <SensoryDial label="Acidity" i18n="wine.acidity" value={profile.acidity} />
      </div>
      <dl class="mt-9 grid grid-cols-2 gap-4 md:grid-cols-4">
        <PropertyCard label="Serve at" i18n="wine.temperature" featured>
          {temperature[0]}–{temperature[1]} °C
          <span class="mt-1 block font-sans text-xs font-normal">{Math.round(temperature[0] * 9/5 + 32)}–{Math.round(temperature[1] * 9/5 + 32)} °F</span>
          {!wine.data.servingTemperature && <span class="mt-2 block font-sans text-xs font-normal" data-i18n="wine.temperatureGuide">Style guide</span>}
        </PropertyCard>
        <PropertyCard label="Body" i18n="wine.body"><span data-i18n={bodyKey}>{t(bodyKey)}</span></PropertyCard>
        <PropertyCard label="Tannin" i18n="wine.tannin"><span data-i18n={tanninKey}>{t(tanninKey)}</span></PropertyCard>
        <PropertyCard label={wine.data.aftertaste ? 'Finish' : 'Primary notes'} i18n={wine.data.aftertaste ? 'wine.aftertaste' : 'wine.primaryNotes'}>
          {wine.data.aftertaste ? <span data-es-value={wine.data.aftertasteEs}>{wine.data.aftertaste}</span> : wine.data.flavouring?.primary.length ? <span class="text-base" data-es-value={wine.data.flavouringEs?.primary.length ? wine.data.flavouringEs.primary.slice(0,2).join(' · ') : undefined}>{wine.data.flavouring.primary.slice(0,2).join(' · ')}</span> : <span class="font-sans text-sm font-normal text-muted" data-i18n="wine.notRecorded">Not yet recorded</span>}
        </PropertyCard>
      </dl>
    </section>

    <section id="pairings" class="mt-16 md:mt-20">
      <h2 class="section-title" data-i18n="wine.pairings">Pairings</h2>
      <nav class="mt-6 flex gap-6 border-b border-rule" aria-label="Choose a pairing occasion">
        <a href="?occasion=meal#pairings" class="min-h-11 inline-flex items-center border-b-2 border-transparent text-sm font-semibold text-muted hover:text-ink" data-occasion-link="meal" data-i18n="wine.mealPairings">With a meal</a>
        <a href="?occasion=snack#pairings" class="min-h-11 inline-flex items-center border-b-2 border-transparent text-sm font-semibold text-muted hover:text-ink" data-occasion-link="snack" data-i18n="wine.snackPairings">For a snack</a>
      </nav>
      {feeds.map(({ occasion, entries, groups }) => <div class="mt-8" data-occasion-feed={occasion} hidden>
        {occasion === 'snack' ? <section>
          <h3 class="font-display text-2xl italic" data-i18n="wine.snackSuggestions">Bites for this wine</h3>
          {entries.length ? <ul class="mt-4 divide-y divide-rule border-t border-rule">{entries.map(({ dish, result, prose }) => <li><DishPairing dish={dish} wineId={wine.id} occasion="snack" tier={result.tier} prose={prose} /></li>)}</ul> : <p class="mt-4 text-muted" data-i18n="wine.noOccasionPairings">No pairings for this occasion have been curated yet.</p>}
        </section> : <>
          {!groups.length && <p class="text-muted" data-i18n="wine.noOccasionPairings">No pairings for this occasion have been curated yet.</p>}
          <div class={`grid items-start gap-10 lg:gap-6 ${groupGrid[groups.length]}`}>
            {groups.map(({ mode, entries }) => <section>
              <h3 class="font-display text-2xl italic" data-i18n={`mode.${mode}`}>{t(`mode.${mode}`)}</h3>
              <p class="mt-2 text-sm text-muted" data-i18n={`mode.${mode}Hint`}>{t(`mode.${mode}Hint`)}</p>
              <ul class="mt-4 divide-y divide-rule border-t border-rule">
                {entries.slice(0, 3).map(({ dish, result, prose }) => <li><DishPairing dish={dish} wineId={wine.id} occasion="meal" tier={result.tier} prose={prose} /></li>)}
              </ul>
              {entries.length > 3 && <details class="border-t border-rule"><summary class="cursor-pointer py-4 text-sm font-semibold" data-es-value={`Ver ${entries.length - 3} maridajes más`}>View {entries.length - 3} more pairings</summary><ul class="divide-y divide-rule">{entries.slice(3).map(({ dish, result, prose }) => <li><DishPairing dish={dish} wineId={wine.id} occasion="meal" tier={result.tier} prose={prose} /></li>)}</ul></details>}
            </section>)}
          </div>
        </>}
        {occasion === 'snack' && boardGuides.length > 0 && <section class="mt-14 border-t border-rule pt-8">
          <h3 class="font-display text-2xl font-semibold" data-i18n="wine.guidedBoards">Build a cheese board</h3>
          <p class="mt-2 max-w-prose text-sm text-muted" data-i18n="wine.guidedBoardsNote">Each cheese keeps its own pairing; the board itself receives no averaged verdict.</p>
          {boardGuides.map(({ board, components }) => {
            const recommendedCount = components.filter(({ prose, result }) => prose && result.tier !== 'skip').length;
            return <article class="mt-6 border-t border-rule pt-5">
              <h4 class="font-display text-xl font-semibold" data-es-value={board.data.nameEs}>{board.data.name}</h4>
              <p class="mt-1 text-sm text-muted" data-es-value={board.data.descriptionEs}>{board.data.description}</p>
              <p class="mt-3 text-xs text-muted" data-es-value={`Maridajes recomendados para ${recommendedCount} de ${components.length} componentes.`}>Recommended pairings for {recommendedCount} of {components.length} components.</p>
              <ul class="mt-3 divide-y divide-rule border-t border-rule">
                {components.map(({ dish, result, prose }) => <li>
                  {prose && result.tier !== 'skip' ? <DishPairing dish={dish} wineId={wine.id} occasion="snack" tier={result.tier} prose={prose} /> : <a href={`/dish/${dish.id}?wine=${wine.id}&occasion=snack`} class="block py-4">
                    <span class="font-display text-lg font-semibold" data-es-value={dish.data.nameEs}>{dish.data.name}</span>
                    <span class="mt-1 block text-sm text-muted underline decoration-rule underline-offset-4" data-i18n="wine.componentBetterElsewhere">Better with another wine</span>
                  </a>}
                </li>)}
              </ul>
            </article>;
          })}
        </section>}
      </div>)}
    </section>

    <section class="mt-16">
      <h2 class="section-title" data-i18n="wine.character">In the glass</h2>
      <div class="mt-6 grid gap-8 md:grid-cols-[2fr_1fr]">
        <div>
          <p class="max-w-prose leading-relaxed text-muted" data-es-value={wine.data.summaryEs}>{wine.data.summary}</p>
          {wine.data.pedagogicalRole && <details class="mt-5 border-y border-rule py-3"><summary class="cursor-pointer py-3 text-sm font-semibold" data-i18n="wine.teachingNote">Teaching note</summary><p class="pb-3 pt-2 text-sm leading-relaxed text-muted" data-es-value={wine.data.pedagogicalRoleEs}>{wine.data.pedagogicalRole}</p></details>}
        </div>
        <dl class="space-y-3 text-sm">
          <div><dt class="text-muted" data-i18n="wine.colour">Colour</dt><dd class="mt-1" data-i18n={`color.${wine.data.color}`}>{t(`color.${wine.data.color}`)}</dd></div>
          {wine.data.style && <div><dt class="text-muted" data-i18n="catalog.style">Style</dt><dd class="mt-1" data-es-value={wine.data.styleEs}>{wine.data.style}</dd></div>}
        </dl>
      </div>
      {fromRegion && (
        <div class="mt-10">
          <PhotoBand
            src={fromRegion.image}
            alt={fromRegion.alt ?? (region ? `${region.data.name} scene` : 'Wine region')}
            label={region ? `From ${region.data.name}` : undefined}
            labelEs={region ? `De ${region.data.nameEs ?? region.data.name}` : undefined}
            credit={fromRegion.creditLine}
          />
        </div>
      )}
    </section>

    {wine.data.flavouring && notes.some((key) => wine.data.flavouring?.[key]?.length) && <section class="mt-16">
      <h2 class="section-title" data-i18n="wine.flavouring">Flavour notes</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-3">
        {notes.map((key) => wine.data.flavouring?.[key]?.length ? <div><dt class="text-sm text-muted" data-i18n={`wine.${key}Notes`}>{t(`wine.${key}Notes`)}</dt><dd class="mt-2 font-display text-xl" data-es-value={wine.data.flavouringEs?.[key]?.length ? wine.data.flavouringEs[key].join(' · ') : undefined}>{wine.data.flavouring[key].join(' · ')}</dd></div> : null)}
      </dl>
    </section>}

    {wine.data.tanninProfile && <section class="mt-16">
      <h2 class="section-title" data-i18n="wine.tanninDetail">A closer look at tannins</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">{tanninAxes.map((key) => {
        const value = wine.data.tanninProfile?.[key];
        return value != null && <SensoryDial label={t(`wine.${key}`)} i18n={`wine.${key}`} value={value} />;
      })}</div>
    </section>}

    {wine.data.recommendedPairings.length > 0 && <section class="mt-12"><h2 class="font-display text-2xl" data-i18n="wine.quickHints">Quick hints</h2><p class="mt-3 text-muted" data-es-value={wine.data.recommendedPairingsEs.length ? wine.data.recommendedPairingsEs.join(' · ') : undefined}>{wine.data.recommendedPairings.join(' · ')}</p></section>}
    {wine.data.availability && <section class="mt-16 rounded-xl bg-surface p-6"><h2 class="font-display text-2xl" data-i18n="wine.whereToFind">Where to find it</h2><p class="mt-3 max-w-prose text-sm leading-relaxed text-muted" data-es-value={wine.data.availability.noteEs}>{wine.data.availability.note}</p>{wine.data.availability.sourceUrl && <a href={wine.data.availability.sourceUrl} target="_blank" rel="noopener noreferrer" class="editorial-link mt-3" data-i18n="wine.viewListing">View listing</a>}</section>}
    <a href="/wines" data-catalog-return class="editorial-link mt-10" data-i18n="wine.back">All wines</a>
  </main>
</Base>
<script>
  function initPairingOccasion() {
    const feeds = [...document.querySelectorAll<HTMLElement>('[data-occasion-feed]')];
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-occasion-link]')];
    if (!feeds.length || !links.length) return;
    const select = (occasion: string, updateUrl = false) => {
      const selected = occasion === 'snack' ? 'snack' : 'meal';
      feeds.forEach((feed) => { feed.hidden = feed.dataset.occasionFeed !== selected; });
      links.forEach((link) => {
        const active = link.dataset.occasionLink === selected;
        link.setAttribute('aria-current', active ? 'page' : 'false');
        link.classList.toggle('border-ink', active);
        link.classList.toggle('text-ink', active);
        link.classList.toggle('border-transparent', !active);
      });
      if (updateUrl) {
        const url = new URL(location.href);
        url.searchParams.set('occasion', selected);
        url.hash = 'pairings';
        history.replaceState(history.state, '', url);
      }
    };
    links.forEach((link) => link.addEventListener('click', (event) => {
      event.preventDefault();
      select(link.dataset.occasionLink ?? 'meal', true);
    }));
    select(new URLSearchParams(location.search).get('occasion') ?? 'meal');
    if (location.hash === '#pairings') {
      requestAnimationFrame(() => requestAnimationFrame(() => document.querySelector('#pairings')?.scrollIntoView({ block: 'start' })));
    }
  }
  document.addEventListener('astro:page-load', initPairingOccasion);
  initPairingOccasion();
</script>
