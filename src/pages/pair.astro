---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CatalogHero from '../components/CatalogHero.astro';
import tableImage from '../assets/pair-table.webp';
import pairSource from '../assets/pair-table.source.json';
const dishes = await getCollection('dishes');
const sortedDishes = dishes.sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<Base title="Find a pairing — Paircraft" description="Describe your dish and find a pairing in the guide.">
  <main class="pair-page page-shell max-w-3xl pt-6 md:pt-10">
    <CatalogHero image={tableImage} alt={pairSource.alt}>
      <Fragment slot="head">
        <h1 class="hero-title"><span data-i18n="pair.headingLead">Find a food</span> <em data-i18n="pair.headingAccent">pairing</em>.</h1>
        <p class="hero-intro" data-i18n="pair.intro">Choose whether you’re pairing a meal or something to snack on, then tell us what food you have in mind.</p>
      </Fragment>
      <div slot="search">
        <nav class="flex gap-[0.6rem]" aria-label="Choose a food occasion">
          <a href="?occasion=meal" class="type-pill is-on-photo px-4" data-pair-occasion="meal" data-i18n="pair.forMeal">For a meal</a>
          <a href="?occasion=snack" class="type-pill is-on-photo px-4" data-pair-occasion="snack" data-i18n="pair.forSnack">For a snack</a>
        </nav>
        <form id="pair-form" class="mt-4" aria-describedby="pair-status">
          <label for="pair-query" id="pair-label" class="mb-[0.45rem] block text-xs font-light">Describe the food</label>
          <textarea id="pair-query" name="query" rows="3" required minlength="3" maxlength="300" class="hero-textarea" placeholder="For example: grilled salmon with lemon and herbs"></textarea>
          <button id="pair-submit" type="submit" class="action mt-[0.9rem] w-full" data-i18n="pair.submit">Find a dish to pair</button>
        </form>
      </div>
      <a slot="foot" href="/wine-style" class="hero-link text-xs" data-i18n="wineStyle.missingBottle">Not in the catalogue? Find an example by style.</a>
    </CatalogHero>
    <p id="pair-status" role="status" aria-live="polite" class="mt-5 text-sm font-light text-muted"></p>
    <section id="pair-results" hidden class="mt-6" aria-labelledby="pair-result-title">
      <h2 id="pair-result-title" class="font-display text-[1.6rem] font-normal" tabindex="-1"></h2>
      <p id="pair-related-hint" class="mt-2 text-[0.8125rem] font-light text-muted" data-i18n="pair.relatedHint">These are starting points. A different sauce or cooking method can change the pairing.</p>
      <ul class="mt-4 grid gap-[0.9rem]">
        {dishes.map((dish) => <li hidden data-result-id={dish.id}><a href={`/dish/${dish.id}`} class="block bg-surface p-[1.15rem] tile-shadow"><h3 class="font-display text-[1.3rem] font-normal" data-es-value={dish.data.nameEs}>{dish.data.name}</h3><p class="mt-[0.45rem] text-sm font-light leading-[1.55] text-muted" data-es-value={dish.data.descriptionEs}>{dish.data.description}</p><span class="mt-[0.8rem] block text-[0.6875rem] uppercase tracking-[0.04em]" data-i18n={dish.data.format === 'bite' ? 'dish.winesForBite' : 'dish.winesForDish'}>{dish.data.format === 'bite' ? 'Wines for this bite' : 'Wines for this dish'}</span></a></li>)}
      </ul>
    </section>
    <section class="mt-[1.6rem]">
      <h2 class="text-xs font-light" data-i18n="pair.familiar">Or start with a familiar food</h2>
      <ul class="mt-[0.6rem] flex flex-wrap gap-[0.6rem]">{sortedDishes.map((dish) => <li data-familiar-occasion={dish.data.occasion.join(',')}><a href={`/dish/${dish.id}`} class="relative inline-flex min-h-[1.6rem] items-center rounded-full border border-ink px-[0.85rem] py-[0.2rem] text-xs font-light transition-colors hover:bg-ink/10 after:absolute after:-inset-y-[0.3rem] after:inset-x-0 after:content-['']" data-es-value={dish.data.nameEs}>{dish.data.name}</a></li>)}</ul>
      <a href="/dishes" class="mt-2 inline-flex min-h-11 items-center text-xs uppercase tracking-[0.04em] underline underline-offset-[0.25em]" data-i18n="dishes.all">All dishes</a>
    </section>
    <noscript><p class="mt-5">Enable JavaScript to search, or use the dish links above. / Activa JavaScript para buscar o usa los enlaces de platos.</p></noscript>
  </main>
</Base>
<script>
  import { t, type Locale } from '../lib/i18n';
  function applyPairOccasionCopy() {
    const occasion = new URLSearchParams(location.search).get('occasion') === 'snack' ? 'snack' : 'meal';
    const lang = document.documentElement.lang === 'es' ? 'es' : 'en';
    const dictionary = JSON.parse(document.querySelector('#i18n-dict')?.textContent ?? '{}');
    const labelKey = occasion === 'snack' ? 'pair.labelSnack' : 'pair.label';
    const placeholderKey = occasion === 'snack' ? 'pair.placeholderSnack' : 'pair.placeholder';
    const label = document.querySelector<HTMLElement>('#pair-label');
    const query = document.querySelector<HTMLTextAreaElement>('#pair-query');
    const submitKey = occasion === 'snack' ? 'pair.submitSnack' : 'pair.submit';
    const submit = document.querySelector<HTMLButtonElement>('#pair-submit');
    if (label) label.textContent = dictionary[labelKey]?.[lang] ?? dictionary[labelKey]?.en ?? '';
    if (query) query.placeholder = dictionary[placeholderKey]?.[lang] ?? dictionary[placeholderKey]?.en ?? '';
    if (submit) { submit.dataset.i18n = submitKey; submit.textContent = dictionary[submitKey]?.[lang] ?? dictionary[submitKey]?.en ?? ''; }
  }
  function initPair() {
    const form = document.querySelector<HTMLFormElement>('#pair-form');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    const query = document.querySelector<HTMLTextAreaElement>('#pair-query')!;
    const button = document.querySelector<HTMLButtonElement>('#pair-submit')!;
    const status = document.querySelector<HTMLElement>('#pair-status')!;
    const results = document.querySelector<HTMLElement>('#pair-results')!;
    const title = document.querySelector<HTMLElement>('#pair-result-title')!;
    const occasion = new URLSearchParams(location.search).get('occasion') === 'snack' ? 'snack' : 'meal';
    document.querySelectorAll<HTMLAnchorElement>('[data-pair-occasion]').forEach((link) => {
      const active = link.dataset.pairOccasion === occasion;
      link.setAttribute('aria-current', active ? 'page' : 'false');
    });
    document.querySelectorAll<HTMLElement>('[data-familiar-occasion]').forEach((item) => {
      item.hidden = !item.dataset.familiarOccasion?.split(',').includes(occasion);
    });
    let controller: AbortController | undefined;
    const locale = () => (document.documentElement.lang === 'es' ? 'es' : 'en') as Locale;
    document.addEventListener('astro:before-swap', () => controller?.abort(), { once: true });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      const text = query.value.trim();
      if (text.length < 3 || text.length > 300) { status.textContent = t('pair.invalid', locale()); query.focus(); return; }
      controller = new AbortController();
      const timeout = setTimeout(() => controller?.abort(), 20000);
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      button.textContent = t('pair.loading', locale());
      status.textContent = t('pair.loading', locale());
      results.hidden = true;
      document.querySelectorAll<HTMLElement>('[data-result-id]').forEach((item) => item.hidden = true);
      try {
        const response = await fetch('/api/pair', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query: text, occasion }), signal: controller.signal });
        if (!response.ok) throw new Error('Search failed');
        const data = await response.json();
        if (!Array.isArray(data.dishIds)) throw new Error('Invalid response');
        let count = 0;
        document.querySelectorAll<HTMLElement>('[data-result-id]').forEach((item) => { item.hidden = !data.dishIds.includes(item.dataset.resultId); if (!item.hidden) count++; });
        status.textContent = count ? '' : t('pair.empty', locale());
        if (count) {
          title.textContent = t(`${data.kind === 'exact' ? 'pair.exact' : 'pair.related'}${occasion === 'snack' ? 'Snack' : ''}`, locale());
          document.querySelector<HTMLElement>('#pair-related-hint')!.hidden = data.kind === 'exact';
          results.hidden = false;
          title.focus();
        }
      } catch { status.textContent = t('pair.error', locale()); }
      finally { clearTimeout(timeout); button.disabled = false; button.textContent = t(button.dataset.i18n ?? 'pair.submit', locale()); form.removeAttribute('aria-busy'); }
    });
  }
  document.addEventListener('astro:page-load', initPair);
  document.addEventListener('astro:page-load', applyPairOccasionCopy);
  document.addEventListener('DOMContentLoaded', applyPairOccasionCopy, { once: true });
  initPair();
  applyPairOccasionCopy();
</script>
