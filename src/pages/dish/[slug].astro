---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { computeTier, dominantMode, type Tier } from '../../lib/tier.ts';
import type { Mode } from '../../lib/rules.ts';
import TierBadge from '../../components/TierBadge.astro';
import { foodTagEs, t } from '../../lib/i18n';

export async function getStaticPaths() {
  const dishes = await getCollection('dishes');
  return dishes.map((dish) => ({ params: { slug: dish.id }, props: { dish } }));
}

const { dish } = Astro.props;
const boardComponents = await Promise.all(dish.data.components.map((component) => getEntry(component)));
const allWines = await getCollection('wines');
const wineNameIndex = allWines.map(({ id, data }) => ({ id, name: data.name, nameEs: data.nameEs }));
const allPairings = await getCollection('pairings');
const pairingMap = new Map(
  allPairings.map((p) => [`${p.data.wine.id}__${p.data.dish.id}`, p.data.explanation]),
);
const pairingMapEs = new Map(
  allPairings.map((p) => [`${p.data.wine.id}__${p.data.dish.id}`, p.data.explanationEs]),
);

const MODES: readonly Mode[] = ['harmony', 'contrast', 'enhancement'] as const;
const MODE_LABEL: Record<Mode, string> = {
  harmony: 'by Harmony',
  contrast: 'by Contrast',
  enhancement: 'by Enhancement',
};
const TIER_ORDER: Record<Tier, number> = {
  decisive: 0,
  'worth-trying': 1,
  risky: 2,
  skip: 3,
};

const wineResults = dish.data.format === 'board' ? [] : allWines.map((wine) => ({
  wine,
  result: computeTier(wine.data, dish.data),
  explanation: pairingMap.get(`${wine.id}__${dish.id}`),
})).filter(({ wine }) => pairingMap.has(`${wine.id}__${dish.id}`));

const winesByMode = MODES.map((mode) => ({
  mode,
  entries: wineResults
    .filter(
      ({ result }) =>
        result.tier !== 'skip' && dominantMode(result.activations) === mode,
    )
    .sort((a, b) => TIER_ORDER[a.result.tier] - TIER_ORDER[b.result.tier]),
}));

const skipWines = wineResults.filter(({ result }) => result.tier === 'skip');

const TAGS = [
  ...dish.data.protein,
  ...dish.data.cookingMethod,
  ...dish.data.flavorProfile,
].filter((tag) => tag !== 'none');
const weightKey = `dish.weight${dish.data.weight.charAt(0).toUpperCase()}${dish.data.weight.slice(1)}`;
---

<Base title={`${dish.data.name} — Paircraft`} description={dish.data.description}>
  <main class="page-shell max-w-3xl">
    <div class="mb-6 flex flex-wrap gap-x-6 gap-y-2">
      <a href="/dishes" class="editorial-link text-muted" data-i18n="dishes.all">All dishes</a>
      <a id="return-to-wine" hidden class="editorial-link"><span id="return-to-wine-label">Back to</span> <span id="return-to-wine-name"></span></a>
    </div>
    <header>
      <h1 class="text-balance font-display text-[clamp(2.35rem,6.5vw,3.75rem)] font-normal leading-[1.1]" data-es-value={dish.data.nameEs}>{dish.data.name}</h1>
      {dish.data.cuisineContext && dish.data.format !== 'board' && <p class="mt-[0.4rem] text-[0.8125rem] font-light italic text-muted" data-es-value={dish.data.cuisineContextEs}>{dish.data.cuisineContext}</p>}
      <p class="mt-[0.9rem] max-w-[36rem] text-[0.9375rem] font-light leading-[1.6]" data-es-value={dish.data.descriptionEs}>{dish.data.description}</p>
    </header>
    <dl class="spec-list mt-7">
      {dish.data.category && <div><dt data-i18n="dish.category">Category</dt><dd data-es-value={dish.data.categoryEs}>{dish.data.category}</dd></div>}
      <div><dt data-i18n="dish.weight">Weight</dt><dd><span data-i18n={weightKey}>{t(weightKey)}</span></dd></div>
      <div><dt data-i18n="dish.intensityLabel">Intensity</dt><dd>{dish.data.intensity}<span class="text-muted"> / 5</span></dd></div>
    </dl>
    {TAGS.length > 0 && <ul class="mt-5 flex flex-wrap gap-[0.45rem]">{TAGS.map((tag) => <li class="tag-pill" data-es-value={foodTagEs(tag)}>{tag.replace(/-/g, ' ')}</li>)}</ul>}
    {dish.data.pairingLogic && <aside class="tile-shadow mt-8 bg-surface px-[1.15rem] pb-[1.3rem] pt-[1.15rem]">
      <h2 class="text-[0.6875rem] uppercase tracking-[0.06em] text-muted" data-i18n="dish.pairingLogic">The pairing logic</h2>
      <p class="mt-2 font-display text-[1.2rem] italic leading-[1.45]" data-es-value={dish.data.pairingLogicEs}>{dish.data.pairingLogic}</p>
    </aside>}
    {dish.data.format !== 'board' && dish.data.recommendedWineStyles && dish.data.recommendedWineStyles.length > 0 && <section class="mt-7">
      <h2 class="mb-[0.6rem] font-display text-[1.2rem] font-normal italic" data-i18n="dish.quickHints">Quick hints</h2>
      <ul class="flex flex-wrap gap-[0.45rem]">{dish.data.recommendedWineStyles.map((style, i) => <li class="tag-pill border-ink" data-es-value={dish.data.recommendedWineStylesEs[i]}>{style}</li>)}</ul>
    </section>}
    {dish.data.format === 'board' && <section class="mt-12">
      <h2 class="section-title" data-i18n="dish.boardComponents">On this board</h2>
      <p class="mt-[0.4rem] text-[0.8125rem] font-light text-muted" data-i18n="dish.boardNote">Each cheese has its own character and pairing. Explore them one by one.</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">{boardComponents.filter((component) => component).map((component) => <li><a href={`/dish/${component!.id}`} class="tile-shadow group block h-full bg-surface px-[1.15rem] pb-[1.15rem] pt-[1.05rem]"><h3 class="font-display text-[1.3rem] font-normal group-hover:underline" data-es-value={component!.data.nameEs}>{component!.data.name}</h3><p class="mt-[0.4rem] text-[0.8125rem] font-light leading-[1.55] text-muted" data-es-value={component!.data.descriptionEs}>{component!.data.description}</p></a></li>)}</ul>
    </section>}
    {dish.data.format !== 'board' && <section class="mt-12">
      <h2 class="section-title" data-i18n={dish.data.format === 'bite' ? 'dish.winesForBite' : 'dish.winesForDish'}>{dish.data.format === 'bite' ? 'Wines for this bite' : 'Wines for this dish'}</h2>
      {winesByMode.every(({ entries }) => entries.length === 0) && <p class="mt-4 text-sm font-light text-muted" data-i18n="dish.noWines">No wines pair well yet.</p>}
      <div class="mt-7 grid gap-10">
        {winesByMode.map(({ mode, entries }) => entries.length === 0 ? null : <div>
          <h3 class="font-display text-[1.45rem] font-normal italic" data-i18n-mode={mode}>{MODE_LABEL[mode]}</h3>
          <ul class="mt-4 grid gap-3">{entries.map(({ wine, result, explanation }) => <li><a href={`/wine/${wine.id}?occasion=${dish.data.occasion.includes('snack') ? 'snack' : 'meal'}#pairings`} class="tile-shadow group block h-full bg-surface px-[1.15rem] pb-5 pt-[1.1rem]">
            <TierBadge tier={result.tier} />
            <h4 class="mt-3 font-display text-[1.3rem] font-normal leading-[1.2] group-hover:underline">{wine.data.name}{wine.data.vintage && <span class="text-muted"> {wine.data.vintage}</span>}</h4>
            {explanation && <p class="mt-2 font-display text-[1.02rem] italic leading-[1.5]" data-es-value={pairingMapEs.get(`${wine.id}__${dish.id}`)}>{explanation}</p>}
          </a></li>)}</ul>
        </div>)}
      </div>
    </section>}
    {dish.data.format !== 'board' && skipWines.length > 0 && <section class="mt-12">
      <h2 class="mb-[0.6rem] font-display text-[1.2rem] font-normal italic" data-i18n="dish.betterChoices">Better choices elsewhere</h2>
      <ul class="flex flex-wrap gap-[0.45rem]">{skipWines.map(({ wine }) => <li><a href={`/wine/${wine.id}`} class="tag-pill text-muted transition-colors hover:border-ink hover:text-ink">{wine.data.name}{wine.data.vintage && <span> {wine.data.vintage}</span>}</a></li>)}</ul>
    </section>}
  </main>
</Base>
<script type="application/json" id="wine-name-index" set:html={JSON.stringify(wineNameIndex)}></script>
<script>
  function restoreWineContext() {
    const id = new URLSearchParams(location.search).get('wine');
    const back = document.querySelector<HTMLAnchorElement>('#return-to-wine');
    if (!id || !back) return;
    const wine = (JSON.parse(document.querySelector('#wine-name-index')?.textContent ?? '[]') as { id: string; name: string; nameEs?: string }[]).find((entry) => entry.id === id);
    if (!wine) return;
    const occasion = new URLSearchParams(location.search).get('occasion') === 'snack' ? 'snack' : 'meal';
    back.href = `/wine/${id}?occasion=${occasion}#pairings`;
    document.querySelector<HTMLElement>('#return-to-wine-label')!.textContent = document.documentElement.lang === 'es' ? 'Volver a' : 'Back to';
    document.querySelector<HTMLElement>('#return-to-wine-name')!.textContent = document.documentElement.lang === 'es' ? wine.nameEs || wine.name : wine.name;
    back.hidden = false;
  }
  document.addEventListener('astro:page-load', restoreWineContext);
  restoreWineContext();
</script>
