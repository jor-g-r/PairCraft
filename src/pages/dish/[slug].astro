---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { computeTier, type Tier } from '../../lib/tier.ts';
import type { Mode } from '../../lib/rules.ts';
import TierBadge from '../../components/TierBadge.astro';
import Eyebrow from '../../components/Eyebrow.astro';

export async function getStaticPaths() {
  const dishes = await getCollection('dishes');
  return dishes.map((dish) => ({ params: { slug: dish.id }, props: { dish } }));
}

const { dish } = Astro.props;
const allWines = await getCollection('wines');
const allPairings = await getCollection('pairings');
const pairingMap = new Map(
  allPairings.map((p) => [`${p.data.wine.id}__${p.data.dish.id}`, p.data.explanation]),
);

const MODES: readonly Mode[] = ['harmony', 'contrast', 'enhancement'] as const;
const MODE_LABEL: Record<Mode, string> = {
  harmony: 'by Harmony',
  contrast: 'by Contrast',
  enhancement: 'by Enhancement',
};
const TIER_ORDER: Record<Tier, number> = {
  decisive: 0,
  'worth-trying': 1,
  risky: 2,
  skip: 3,
};

const wineResults = allWines.map((wine) => ({
  wine,
  result: computeTier(wine.data, dish.data),
  explanation: pairingMap.get(`${wine.id}__${dish.id}`),
}));

const winesByMode = MODES.map((mode) => ({
  mode,
  entries: wineResults
    .filter(
      ({ result }) =>
        result.tier !== 'skip' && result.activations.some((r) => r.mode === mode),
    )
    .sort((a, b) => TIER_ORDER[a.result.tier] - TIER_ORDER[b.result.tier]),
}));

const skipWines = wineResults.filter(({ result }) => result.tier === 'skip');

const TAGS = [
  ...dish.data.protein,
  ...dish.data.cookingMethod,
  ...dish.data.flavorProfile,
];
---

<Base title={`${dish.data.name} — Paircraft`} description={dish.data.description}>
  <main class="mx-auto max-w-2xl px-6 py-10 md:py-16">
    <p class="text-sm text-neutral-500 capitalize">
      {dish.data.category && <span>{dish.data.category} · </span>}
      {dish.data.weight} · intensity {dish.data.intensity}
    </p>

    <header class="mt-2">
      <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight">{dish.data.name}</h1>
      {
        dish.data.cuisineContext && (
          <p class="mt-1 text-sm italic text-neutral-500">{dish.data.cuisineContext}</p>
        )
      }
      <p class="mt-3 text-neutral-800 leading-relaxed">{dish.data.description}</p>
    </header>

    {
      TAGS.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {TAGS.map((tag) => (
            <li class="inline-block rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs text-neutral-600 capitalize">
              {tag.replace(/-/g, ' ')}
            </li>
          ))}
        </ul>
      )
    }

    {
      dish.data.pairingLogic && (
        <aside class="mt-10 rounded-lg border-l-4 border-neutral-900 bg-neutral-50 px-5 py-4">
          <Eyebrow>The pairing logic</Eyebrow>
          <p class="mt-2 font-display text-lg italic text-neutral-800 leading-snug">
            {dish.data.pairingLogic}
          </p>
        </aside>
      )
    }

    {
      dish.data.recommendedWineStyles && dish.data.recommendedWineStyles.length > 0 && (
        <section class="mt-8">
          <Eyebrow>Quick hints</Eyebrow>
          <ul class="mt-2 flex flex-wrap gap-2">
            {dish.data.recommendedWineStyles.map((style) => (
              <li class="inline-block rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs text-neutral-600">
                {style}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold">Wines for this dish</h2>
      {
        winesByMode.every(({ entries }) => entries.length === 0) && (
          <p class="mt-4 text-neutral-500">No wines pair well yet.</p>
        )
      }
      {
        winesByMode.map(({ mode, entries }) =>
          entries.length === 0 ? null : (
            <div class="mt-8">
              <h3 class="font-display text-xl italic text-neutral-800">{MODE_LABEL[mode]}</h3>
              <ul class="mt-3 space-y-3">
                {entries.map(({ wine, result, explanation }) => (
                  <li>
                    <a
                      href={`/wine/${wine.id}`}
                      class="block rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 transition hover:border-neutral-400 hover:bg-white"
                    >
                      <div class="flex items-baseline justify-between gap-4">
                        <p class="font-display text-lg font-semibold">
                          {wine.data.name}
                          {wine.data.vintage && (
                            <span class="font-normal text-neutral-500"> {wine.data.vintage}</span>
                          )}
                        </p>
                        <TierBadge tier={result.tier} class="shrink-0" />
                      </div>
                      <p class="mt-1 text-sm italic text-neutral-700">{wine.data.tagline}</p>
                      {explanation && (
                        <p class="mt-2 font-display text-base italic text-neutral-800 leading-snug">
                          {explanation}
                        </p>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ),
        )
      }
    </section>

    {
      skipWines.length > 0 && (
        <section class="mt-12">
          <h3 class="font-display text-xl italic text-neutral-500">Better choices elsewhere</h3>
          <ul class="mt-3 space-y-1.5 text-sm text-neutral-500">
            {skipWines.map(({ wine }) => (
              <li>
                <a href={`/wine/${wine.id}`} class="hover:text-neutral-900 hover:underline">
                  {wine.data.name}
                  {wine.data.vintage && <span> {wine.data.vintage}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>
