---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import { regionImage } from '../../lib/region-images';
import { originLine, t } from '../../lib/i18n';

export async function getStaticPaths() {
  const grapes = await getCollection('grapes');
  return grapes.map((grape) => ({ params: { slug: grape.id }, props: { grape } }));
}

const { grape } = Astro.props;
const { Content } = await render(grape);

const signatureRegions = await Promise.all(
  grape.data.signatureRegions.map((ref) => getEntry(ref)),
);

const allWines = await getCollection('wines');
const wines = allWines.filter((w) => w.data.grapes.some((g) => g.grape.id === grape.id));
const winesWithRegion = await Promise.all(
  wines.map(async (w) => ({ wine: w, region: await getEntry(w.data.region) })),
);
// The page features the first bottle stocked in the visitor's market, so this order is the editorial
// preference: the grape's own colour, then single-variety bottles, then the most widely stocked.
const featuredOrder = [...winesWithRegion].sort((a, b) =>
  Number(a.wine.data.color !== grape.data.color) - Number(b.wine.data.color !== grape.data.color) ||
  a.wine.data.grapes.length - b.wine.data.grapes.length ||
  b.wine.data.markets.length - a.wine.data.markets.length ||
  a.wine.data.name.localeCompare(b.wine.data.name));

const stripRegion = signatureRegions.find((r) => r && regionImage(r.id));
const strip = stripRegion ? regionImage(stripRegion.id) : undefined;
---

<Base
  title={`${grape.data.name} — Paircraft`}
  description={grape.data.tagline}
>
  <main class="page-shell max-w-3xl">
    <a href="/wines" class="editorial-link mb-6 text-muted" data-i18n="wine.back">All wines</a>
    <header>
      <h1 class="page-title" data-es-value={grape.data.nameEs}>{grape.data.name}</h1>
      <p class="mt-2 font-display text-lg italic text-neutral-700" data-es-value={grape.data.taglineEs}>{grape.data.tagline}</p>
      <p class="mt-3 text-sm text-neutral-500"><span data-i18n={`grape.${grape.data.color}`}>{t(`grape.${grape.data.color}`)}</span> · <span data-es-value={grape.data.originEs}>{grape.data.origin}</span></p>
      {
        grape.data.aliases.length > 0 && (
          <p class="mt-2 text-sm text-neutral-500">
            <span data-i18n="grape.alsoCalled">Also called:</span>{' '}{grape.data.aliases.join(', ')}
          </p>
        )
      }
    </header>

    {winesWithRegion.length > 0 && <section class="mt-10 border-y border-rule py-6" aria-labelledby="featured-bottle-title">
      <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_minmax(14rem,0.8fr)] sm:items-end">
        <div>
          <h2 id="featured-bottle-title" class="font-display text-2xl font-semibold" data-i18n="grape.featuredBottle">A bottle to explore</h2>
          <p class="mt-2 max-w-prose text-sm leading-relaxed text-muted" data-i18n="grape.featuredBottleNote">One expression of this grape, selected from bottles listed in your market.</p>
        </div>
        <div class="sm:text-right">
          {featuredOrder.map(({ wine, region }) => <article data-featured-bottle data-markets={wine.data.markets.join(',')} hidden>
            <p class="font-display text-xl font-semibold"><a class="underline decoration-rule underline-offset-4 hover:decoration-current" href={`/wine/${wine.id}`}>{wine.data.name}</a></p>
            {region && <p class="mt-1 text-sm text-muted" data-es-value={originLine(region.data, ' · ').es}>{originLine(region.data, ' · ').en}</p>}
            <p class="mt-2 font-display italic text-muted" data-es-value={wine.data.taglineEs}>{wine.data.tagline}</p>
          </article>)}
          <p data-no-market-bottle hidden class="text-sm text-muted" data-i18n="grape.noMarketBottle">No bottle of this grape is listed in your market yet.</p>
        </div>
      </div>
    </section>}

    {strip && stripRegion && (
      <div class="mt-8">
        <PhotoBand
          src={strip.image}
          alt={strip.alt ?? stripRegion.data.name}
          label={`From ${stripRegion.data.name}`}
          labelEs={`De ${stripRegion.data.nameEs ?? stripRegion.data.name}`}
          credit={strip.creditLine}
          aspect="strip"
        />
      </div>
    )}

    <article class="prose prose-neutral mt-8 max-w-none text-neutral-800 leading-relaxed [&_p]:mt-4" data-lang-content="en">
      <Content />
    </article>
    {
      grape.data.bodyEs && (
        <article class="prose prose-neutral mt-8 max-w-none text-neutral-800 leading-relaxed [&_p]:mt-4 hidden" data-lang-content="es" set:html={grape.data.bodyEs} />
      )
    }

    {
      signatureRegions.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-semibold" data-i18n="grape.signatureRegions">Signature regions</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {signatureRegions.map(
              (r) =>
                r && (
                  <li>
                    <a
                      href={`/region/${r.id}`}
                      class="inline-flex min-h-11 items-center rounded-full border border-rule px-4 py-2 text-sm hover:border-ink transition"
                      data-es-value={r.data.nameEs}
                    >
                      {r.data.name}
                    </a>
                  </li>
                ),
            )}
          </ul>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="section-title" data-i18n="grape.wines">Wines</h2>
      {winesWithRegion.length === 0 && <p class="mt-4 text-neutral-500" data-i18n="grape.noWines">No wines yet.</p>}
      <ul class="mt-4 space-y-3">
        {
          winesWithRegion.map(({ wine, region }) => (
            <li>
              <a
                href={`/wine/${wine.id}`}
                class="block border-t border-rule py-5 transition hover:border-ink"
              >
                <p class="font-display text-lg font-semibold">
                  {wine.data.name}
                  {wine.data.vintage && (
                    <span class="font-normal text-neutral-500"> {wine.data.vintage}</span>
                  )}
                </p>
                <p class="mt-1 text-sm italic text-neutral-700" data-es-value={wine.data.taglineEs}>{wine.data.tagline}</p>
                {region && (
                  <p class="mt-1 text-xs text-neutral-500" data-es-value={originLine(region.data).es}>
                    {originLine(region.data).en}
                  </p>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>
<script>
  function selectMarketBottle() {
    const entries = [...document.querySelectorAll<HTMLElement>('[data-featured-bottle]')];
    if (!entries.length) return;
    const market = document.cookie.match(/(?:^|; )pc_market=([A-Z]{2})(?:;|$)/)?.[1] ?? 'CO';
    const selected = entries.find((entry) => entry.dataset.markets?.split(',').includes(market));
    entries.forEach((entry) => { entry.hidden = entry !== selected; });
    const empty = document.querySelector<HTMLElement>('[data-no-market-bottle]');
    if (empty) empty.hidden = Boolean(selected);
  }
  document.addEventListener('astro:page-load', selectMarketBottle);
  selectMarketBottle();
</script>
