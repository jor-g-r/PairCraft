---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntityCover from '../../components/EntityCover.astro';
import WineCard from '../../components/WineCard.astro';
import WineGlass from '../../components/WineGlass.astro';
import { regionImage } from '../../lib/region-images';
import { originLine, t } from '../../lib/i18n';

export async function getStaticPaths() {
  const grapes = await getCollection('grapes');
  return grapes.map((grape) => ({ params: { slug: grape.id }, props: { grape } }));
}

const { grape } = Astro.props;
const { Content } = await render(grape);

const signatureRegions = await Promise.all(
  grape.data.signatureRegions.map((ref) => getEntry(ref)),
);

const allWines = await getCollection('wines');
const wines = allWines.filter((w) => w.data.grapes.some((g) => g.grape.id === grape.id));
const winesWithRegion = await Promise.all(
  wines.map(async (w) => ({ wine: w, region: await getEntry(w.data.region) })),
);
// The page features the first bottle stocked in the visitor's market, so this order is the editorial
// preference: the grape's own colour, then single-variety bottles, then the most widely stocked.
const featuredOrder = [...winesWithRegion].sort((a, b) =>
  Number(a.wine.data.color !== grape.data.color) - Number(b.wine.data.color !== grape.data.color) ||
  a.wine.data.grapes.length - b.wine.data.grapes.length ||
  b.wine.data.markets.length - a.wine.data.markets.length ||
  a.wine.data.name.localeCompare(b.wine.data.name));

const stripRegion = signatureRegions.find((r) => r && regionImage(r.id));
const strip = stripRegion ? regionImage(stripRegion.id) : undefined;
---

<Base
  title={`${grape.data.name} — Paircraft`}
  description={grape.data.tagline}
>
  <main class="page-shell max-w-3xl">
    <a href="/wines" class="editorial-link mb-6 text-muted" data-i18n="wine.back">All wines</a>
    <EntityCover image={strip?.image} alt={strip?.alt} credit={strip?.creditLine}>
      <h1 class="text-balance font-display text-[clamp(2.35rem,6.5vw,3.75rem)] font-normal leading-[1.1]" data-es-value={grape.data.nameEs}>{grape.data.name}</h1>
      <p class="mt-[0.7rem] max-w-[36rem] font-display text-[1.15rem] italic leading-[1.5]" data-es-value={grape.data.taglineEs}>{grape.data.tagline}</p>
    </EntityCover>
    <dl class="spec-list mt-7">
      <div><dt data-i18n="wine.colour">Colour</dt><dd><span data-i18n={`grape.${grape.data.color}`}>{t(`grape.${grape.data.color}`)}</span></dd></div>
      <div><dt data-i18n="grape.origin">Origin</dt><dd data-es-value={grape.data.originEs}>{grape.data.origin}</dd></div>
      {grape.data.aliases.length > 0 && <div><dt data-i18n="grape.aliases">Also called</dt><dd>{grape.data.aliases.join(', ')}</dd></div>}
    </dl>

    {winesWithRegion.length > 0 && <aside class="tile-shadow mt-8 flex flex-col bg-surface" aria-labelledby="featured-bottle-title">
      {/* The bottle slot: if a placement is ever sold, the brand's cleared bottle photograph and a visible "Sponsored" label go here. */}
      <div class="mx-3 mt-3 grid aspect-[4/3] place-items-center bg-paper"><WineGlass color={grape.data.color} class="h-14 w-14 text-ink" /></div>
      <div class="px-[1.15rem] pb-5 pt-4">
        <h2 id="featured-bottle-title" class="text-[0.6875rem] uppercase tracking-[0.06em] text-muted" data-i18n="grape.featuredBottle">A bottle to explore</h2>
        <p class="mt-[0.3rem] text-xs font-light text-muted" data-i18n="grape.featuredBottleNote">One expression of this grape, selected from bottles listed in your market.</p>
        {featuredOrder.map(({ wine, region }) => <article data-featured-bottle data-markets={wine.data.markets.join(',')} hidden>
          <p class="mt-[0.8rem] font-display text-[1.4rem] leading-[1.15]"><a class="underline decoration-rule underline-offset-[0.15em] hover:decoration-current" href={`/wine/${wine.id}`}>{wine.data.name}</a></p>
          {region && <p class="mt-[0.3rem] text-xs font-light text-muted" data-es-value={originLine(region.data, ' · ').es}>{originLine(region.data, ' · ').en}</p>}
          <p class="mt-[0.6rem] text-sm font-light leading-[1.55] text-muted" data-es-value={wine.data.taglineEs}>{wine.data.tagline}</p>
        </article>)}
        <p data-no-market-bottle hidden class="mt-[0.8rem] text-sm font-light text-muted" data-i18n="grape.noMarketBottle">No bottle of this grape is listed in your market yet.</p>
      </div>
    </aside>}

    <article class="mt-8 max-w-[40rem] text-[0.9375rem] font-light leading-[1.7] [&_p+p]:mt-4" data-lang-content="en">
      <Content />
    </article>
    {grape.data.bodyEs && <article class="mt-8 hidden max-w-[40rem] text-[0.9375rem] font-light leading-[1.7] [&_p+p]:mt-4" data-lang-content="es" set:html={grape.data.bodyEs} />}

    {signatureRegions.length > 0 && <section class="mt-10">
      <h2 class="mb-[0.7rem] font-display text-[1.3rem] font-normal italic" data-i18n="grape.signatureRegions">Signature regions</h2>
      <ul class="flex flex-wrap gap-2">{signatureRegions.map((r) => r && <li><a href={`/region/${r.id}`} class="type-pill h-[2.1rem] px-4 text-[0.8125rem] normal-case" data-es-value={r.data.nameEs}>{r.data.name}</a></li>)}</ul>
    </section>}

    <section class="mt-12">
      <h2 class="section-title" data-i18n="grape.wines">Wines</h2>
      {winesWithRegion.length === 0 && <p class="mt-4 text-sm font-light text-muted" data-i18n="grape.noWines">No wines yet.</p>}
      <ul class="wine-tiles mt-4">{winesWithRegion.map(({ wine, region }) => <li><WineCard wine={wine} region={region} /></li>)}</ul>
    </section>
  </main>
</Base>
<script>
  function selectMarketBottle() {
    const entries = [...document.querySelectorAll<HTMLElement>('[data-featured-bottle]')];
    if (!entries.length) return;
    const market = document.cookie.match(/(?:^|; )pc_market=([A-Z]{2})(?:;|$)/)?.[1] ?? 'CO';
    const selected = entries.find((entry) => entry.dataset.markets?.split(',').includes(market));
    entries.forEach((entry) => { entry.hidden = entry !== selected; });
    const empty = document.querySelector<HTMLElement>('[data-no-market-bottle]');
    if (empty) empty.hidden = Boolean(selected);
  }
  document.addEventListener('astro:page-load', selectMarketBottle);
  selectMarketBottle();
</script>
