---
// Server-rendered so we can read the visitor's market from the Vercel geo header
// / cookie. The rest of the site stays static; only this feed is dynamic.
export const prerender = false;

import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import WineGlass from '../components/WineGlass.astro';

const wines = await getCollection('wines');
const grapes = await getCollection('grapes');
const regions = await getCollection('regions');
const dishes = await getCollection('dishes');
const markets = await getCollection('markets');

// --- Resolve the visitor's market: cookie override > Vercel geo IP > default CO.
const knownMarkets = new Map(markets.map((m) => [m.data.code, m]));
const cookieMarket = Astro.cookies.get('pc_market')?.value;
const geoMarket = Astro.request.headers.get('x-vercel-ip-country');
const marketCode =
  [cookieMarket, geoMarket, 'CO'].find((c) => c && knownMarkets.has(c)) ?? 'CO';
const market = knownMarkets.get(marketCode) ?? null;

// Feed is gated to wines stocked in this market. Search (below) stays global —
// every wine keeps a reachable page; only the browse grid is localized.
const marketWines = wines.filter((w) => w.data.markets.includes(marketCode));
const winesWithRegion = await Promise.all(
  marketWines.map(async (wine) => ({
    wine,
    region: await getEntry(wine.data.region),
  })),
);
winesWithRegion.sort((a, b) => a.wine.data.name.localeCompare(b.wine.data.name));

// Grape-level fallback shown when a market has no curated bottles yet.
const fallbackGrapes = market
  ? (await Promise.all(market.data.dominantGrapes.map((g) => getEntry(g)))).filter(Boolean)
  : [];

interface SearchEntry {
  id: string;
  type: 'wine' | 'grape' | 'region' | 'dish';
  name: string;
  meta?: string;
  /** Wine color, only set for type=wine entries. Used by the dropdown
   * renderer to inline a glass icon. */
  color?: string;
}

const searchIndex: SearchEntry[] = [
  ...winesWithRegion.map(({ wine, region }) => ({
    id: wine.id,
    type: 'wine' as const,
    name: wine.data.name,
    meta: region ? `${region.data.name}, ${region.data.country}` : undefined,
    color: wine.data.color,
  })),
  ...grapes.map((g) => ({ id: g.id, type: 'grape' as const, name: g.data.name })),
  ...regions.map((r) => ({
    id: r.id,
    type: 'region' as const,
    name: r.data.name,
    meta: r.data.country,
  })),
  ...dishes.map((d) => ({ id: d.id, type: 'dish' as const, name: d.data.name })),
];

const countries = [
  ...new Set(winesWithRegion.map(({ region }) => region?.data.country).filter(Boolean) as string[]),
].sort();
---

<Base
  title="Paircraft"
  description="A pocket guide to what pairs with what — wines, grapes, regions, dishes."
>
  <main class="mx-auto max-w-2xl px-6 py-10 md:py-16">
    <header class="text-center">
      <h1 class="font-display text-5xl md:text-7xl font-bold tracking-tight">Paircraft</h1>
      <p class="mt-3 font-display text-lg md:text-xl italic text-neutral-700">
        A pocket guide to what pairs with what.
      </p>
    </header>

    <section class="relative mt-10 md:mt-14">
      <label for="search-input" class="sr-only" data-i18n="home.searchLabel">Search wines, grapes, dishes, or regions</label>
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-neutral-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          id="search-input"
          type="search"
          role="combobox"
          autocomplete="off"
          placeholder="Type a wine, dish, or grape. We do the rest."
          class="w-full rounded-xl border border-neutral-300 bg-white py-4 pl-12 pr-4 text-base md:text-lg shadow-sm focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900/10 transition"
          aria-autocomplete="list"
          aria-controls="search-results"
          aria-expanded="false"
          data-i18n-placeholder="home.searchPlaceholder"
        />
      </div>
      <ul
        id="search-results"
        class="absolute left-0 right-0 top-full z-20 mt-2 hidden overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-lg"
        role="listbox"
      >
      </ul>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-sm">
        <span class="text-neutral-500" data-i18n="home.try">Try:</span>
        <a
          href="/grape/malbec"
          class="rounded-full border border-neutral-300 px-3 py-1 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition"
          >Malbec</a
        >
        <a
          href="/grape/albarino"
          class="rounded-full border border-neutral-300 px-3 py-1 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition"
          >Albariño</a
        >
        <a
          href="/dish/ribeye-grilled"
          class="rounded-full border border-neutral-300 px-3 py-1 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition"
          >Ribeye</a
        >
      </div>
    </section>

    <div class="mt-12 flex items-center gap-3 text-xs uppercase tracking-widest text-neutral-500">
      <div class="flex-1 border-t border-neutral-200"></div>
      <span data-i18n="home.orBrowse">or browse</span>
      <div class="flex-1 border-t border-neutral-200"></div>
    </div>

    <section class="mt-6">
      <div class="flex flex-wrap items-center justify-center gap-2 text-sm">
        <label for="market-select" class="text-neutral-500" data-i18n="home.marketLabel">Showing wines available in</label>
        <div class="relative">
          <select
            id="market-select"
            class="appearance-none rounded-full border border-neutral-300 bg-white py-1 pl-3 pr-8 font-medium text-neutral-900 focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900/10 transition"
          >
            {
              markets
                .slice()
                .sort((a, b) => a.data.name.localeCompare(b.data.name))
                .map((m) => (
                  <option value={m.data.code} selected={m.data.code === marketCode}>
                    {m.data.name}
                  </option>
                ))
            }
          </select>
          <svg
            class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-neutral-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </div>
      </div>

      {
        winesWithRegion.length > 0 ? (
          <>
            <p class="mt-6 text-xs uppercase tracking-widest text-neutral-500" data-i18n="home.origin">Origin</p>
            <div
              class="mt-2 flex flex-wrap gap-2"
              id="region-pills"
              role="group"
              aria-label="Filter by origin"
            >
              <button
                type="button"
                class="region-pill is-active rounded-full border px-3 py-1 text-sm transition"
                data-country=""
                aria-pressed="true"
                data-i18n="home.all"
              >
                All
              </button>
              {countries.map((c) => (
                <button
                  type="button"
                  class="region-pill rounded-full border px-3 py-1 text-sm transition"
                  data-country={c}
                  aria-pressed="false"
                >
                  {c}
                </button>
              ))}
            </div>

            <ul class="mt-5 grid gap-3 sm:grid-cols-2" id="wine-grid">
              {winesWithRegion.map(({ wine, region }) => (
                <li class="wine-card" data-country={region?.data.country ?? ''}>
                  <a
                    href={`/wine/${wine.id}`}
                    class="block h-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-4 transition hover:border-neutral-400 hover:bg-white"
                  >
                    <div class="flex items-start gap-2.5">
                      <WineGlass color={wine.data.color} class="shrink-0 mt-0.5 text-neutral-700" />
                      <p class="font-display text-xl font-semibold leading-tight">
                        {wine.data.name}
                        {wine.data.vintage && (
                          <span class="font-normal text-neutral-500"> {wine.data.vintage}</span>
                        )}
                      </p>
                    </div>
                    {region && (
                      <p class="mt-1 text-xs text-neutral-500">
                        {region.data.name}, {region.data.country}
                      </p>
                    )}
                    <p class="mt-3 text-sm italic text-neutral-700 leading-snug" data-es-value={wine.data.taglineEs}>
                      {wine.data.tagline}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
            <p id="grid-empty" class="mt-6 hidden text-center text-sm text-neutral-500 italic" data-i18n="home.noWinesOrigin">
              No wines from this origin yet.
            </p>
          </>
        ) : (
          <div class="mt-8 text-center">
            <p class="text-sm italic text-neutral-600">
              <span data-i18n="home.noBottles">No bottles curated for</span>{' '}
              {market?.data.name ?? 'this market'}{' '}
              <span data-i18n="home.noBottlesFallback">yet — start from a grape that's widely poured here:</span>
            </p>
            <ul class="mt-5 grid gap-3 sm:grid-cols-2 text-left">
              {fallbackGrapes.map((g) => (
                <li>
                  <a
                    href={`/grape/${g.id}`}
                    class="block h-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-4 transition hover:border-neutral-400 hover:bg-white"
                  >
                    <p class="font-display text-xl font-semibold leading-tight">{g.data.name}</p>
                    <p class="mt-1 text-sm italic text-neutral-700 leading-snug">{g.data.tagline}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  </main>

  <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)}></script>

  <script is:inline>
    function initPaircraftHome() {
      const indexEl = document.getElementById('search-index');
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      if (!indexEl || !input || !results) return;

      /** @type {Array<{id:string,type:string,name:string,meta?:string}>} */
      const entries = JSON.parse(indexEl.textContent || '[]');

      const TYPE_RANK = { wine: 0, grape: 1, dish: 2, region: 3 };
      const TYPE_PATH = { wine: 'wine', grape: 'grape', dish: 'dish', region: 'region' };
      const TYPE_LABEL = { wine: 'wine', grape: 'grape', dish: 'dish', region: 'region' };

      let activeIndex = -1;
      let currentMatches = [];

      function normalize(s) {
        return s
          .toLowerCase()
          .normalize('NFD')
          .replace(/[̀-ͯ]/g, '');
      }

      function search(query) {
        const q = normalize(query.trim());
        if (!q) return [];
        return entries
          .map((e) => {
            const name = normalize(e.name);
            const meta = e.meta ? normalize(e.meta) : '';
            let score = -1;
            if (name.startsWith(q)) score = 0;
            else if (name.includes(q)) score = 1;
            else if (meta.includes(q)) score = 2;
            return score < 0 ? null : { entry: e, score };
          })
          .filter((x) => x !== null)
          .sort((a, b) => {
            if (a.score !== b.score) return a.score - b.score;
            const ta = TYPE_RANK[a.entry.type] ?? 9;
            const tb = TYPE_RANK[b.entry.type] ?? 9;
            if (ta !== tb) return ta - tb;
            return a.entry.name.localeCompare(b.entry.name);
          })
          .slice(0, 8)
          .map((x) => x.entry);
      }

      // SVG markup duplicated from src/components/WineGlass.astro because the
      // dropdown is rendered client-side from a template string. Keep these
      // two in sync when iterating on the glass design.
      const GLASS_FILL = {
        red: 'var(--color-accent)',
        white: '#e8d97e',
        rose: '#e8a4a8',
        orange: '#cf7e2a',
        sparkling: '#e8d97e',
      };
      function glassSvg(color) {
        const fill = GLASS_FILL[color] || GLASS_FILL.white;
        if (color === 'sparkling') {
          return `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" class="shrink-0 text-neutral-700" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 3 V15 C10 16 10.6 17 12 17 C13.4 17 14 16 14 15 V3 Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M11 5 V15 C11 15.5 11.3 16 12 16 C12.7 16 13 15.5 13 15 V5 Z" fill="${fill}"/><line x1="12" y1="17" x2="12" y2="20.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="9.5" y1="21" x2="14.5" y2="21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>`;
        }
        return `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" class="shrink-0 text-neutral-700" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7 3 C7 11 9 14 12 14 C15 14 17 11 17 3 Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.6 6 C8.6 11 10 13 12 13 C14 13 15.4 11 15.4 6 Z" fill="${fill}"/><line x1="12" y1="14" x2="12" y2="20.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="9" y1="21" x2="15" y2="21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>`;
      }

      function render(matches) {
        currentMatches = matches;
        activeIndex = -1;
        if (!matches.length) {
          results.hidden = true;
          results.classList.add('hidden');
          input.setAttribute('aria-expanded', 'false');
          results.innerHTML = '';
          return;
        }
        results.innerHTML = matches
          .map(
            (m, i) => `
            <li role="option" id="search-opt-${i}" data-index="${i}">
              <a href="/${TYPE_PATH[m.type]}/${m.id}"
                 class="flex items-center gap-3 px-4 py-3 hover:bg-neutral-100 transition border-b border-neutral-100 last:border-b-0"
                 data-index="${i}">
                ${m.type === 'wine' && m.color ? glassSvg(m.color) : ''}
                <span class="flex-1 min-w-0">
                  <span class="font-display text-base font-semibold block truncate">${escapeHtml(m.name)}</span>
                  ${m.meta ? `<span class="block text-xs text-neutral-500 truncate">${escapeHtml(m.meta)}</span>` : ''}
                </span>
                <span class="shrink-0 text-[10px] uppercase tracking-wider text-neutral-400 border border-neutral-200 rounded px-1.5 py-0.5" data-i18n-search-type="${m.type}">${TYPE_LABEL[m.type]}</span>
              </a>
            </li>`,
          )
          .join('');
        results.hidden = false;
        results.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'true');
      }

      function escapeHtml(s) {
        return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      function setActive(i) {
        const items = results.querySelectorAll('a');
        items.forEach((el, idx) => {
          if (idx === i) {
            el.classList.add('bg-neutral-100');
            el.setAttribute('aria-selected', 'true');
            input.setAttribute('aria-activedescendant', `search-opt-${i}`);
          } else {
            el.classList.remove('bg-neutral-100');
            el.removeAttribute('aria-selected');
          }
        });
        activeIndex = i;
      }

      input.addEventListener('input', (e) => {
        const q = e.target.value;
        render(search(q));
      });

      input.addEventListener('keydown', (e) => {
        if (!currentMatches.length) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive((activeIndex + 1) % currentMatches.length);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(activeIndex <= 0 ? currentMatches.length - 1 : activeIndex - 1);
        } else if (e.key === 'Enter') {
          if (activeIndex >= 0) {
            e.preventDefault();
            const m = currentMatches[activeIndex];
            window.location.href = `/${TYPE_PATH[m.type]}/${m.id}`;
          }
        } else if (e.key === 'Escape') {
          input.blur();
          render([]);
        }
      });

      document.addEventListener('click', (e) => {
        if (!results.contains(e.target) && e.target !== input) {
          render([]);
        }
      });

      // Region pills + grid filter
      const pills = document.querySelectorAll('.region-pill');
      const cards = document.querySelectorAll('.wine-card');
      const empty = document.getElementById('grid-empty');

      function applyFilter(country) {
        let visible = 0;
        cards.forEach((card) => {
          const match = !country || card.dataset.country === country;
          card.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        if (empty) empty.classList.toggle('hidden', visible > 0);
      }

      pills.forEach((p) => {
        p.addEventListener('click', () => {
          pills.forEach((q) => {
            q.classList.remove('is-active');
            q.setAttribute('aria-pressed', 'false');
          });
          p.classList.add('is-active');
          p.setAttribute('aria-pressed', 'true');
          applyFilter(p.dataset.country || '');
        });
      });

      // Market selector — persist the choice (overrides geo) and re-render the
      // localized feed server-side on reload.
      const marketSelect = document.getElementById('market-select');
      if (marketSelect) {
        marketSelect.addEventListener('change', () => {
          const code = encodeURIComponent(marketSelect.value);
          document.cookie = `pc_market=${code}; path=/; max-age=31536000; samesite=lax`;
          window.location.reload();
        });
      }
    }
    document.addEventListener('astro:page-load', initPaircraftHome);
  </script>

  <style>
    .region-pill {
      border-color: rgb(212 212 212); /* neutral-300 */
      color: rgb(64 64 64); /* neutral-700 */
    }
    .region-pill:hover {
      border-color: rgb(23 23 23); /* neutral-900 */
    }
    .region-pill.is-active {
      background-color: var(--color-accent);
      color: white;
      border-color: var(--color-accent);
    }
  </style>
</Base>
