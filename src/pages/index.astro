---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const wines = await getCollection('wines');
const grapes = await getCollection('grapes');
const regions = await getCollection('regions');
const dishes = await getCollection('dishes');

const winesWithRegion = await Promise.all(
  wines.map(async (wine) => ({
    wine,
    region: await getEntry(wine.data.region),
  })),
);
---

<Base
  title="Paircraft"
  description="A pocket guide to what pairs with what — wines, grapes, regions, dishes."
>
  <main class="mx-auto max-w-2xl px-6 py-12 md:py-20">
    <header class="text-center">
      <h1 class="font-display text-5xl md:text-7xl font-bold tracking-tight">Paircraft</h1>
      <p class="mt-4 font-display text-lg md:text-xl italic text-neutral-700">
        A pocket guide to what pairs with what.
      </p>
    </header>

    <section class="mt-16">
      <h2 class="font-display text-2xl font-semibold">Wines</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          winesWithRegion.map(({ wine, region }) => (
            <li>
              <a
                href={`/wine/${wine.id}`}
                class="block h-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-4 transition hover:border-neutral-400 hover:bg-white"
              >
                <p class="font-display text-xl font-semibold leading-tight">
                  {wine.data.name}
                  {wine.data.vintage && (
                    <span class="font-normal text-neutral-500"> {wine.data.vintage}</span>
                  )}
                </p>
                {region && (
                  <p class="mt-1 text-xs text-neutral-500">
                    {region.data.name}, {region.data.country}
                  </p>
                )}
                <p class="mt-3 text-sm italic text-neutral-700 leading-snug">
                  {wine.data.tagline}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold">By grape</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          grapes.map((g) => (
            <li>
              <a
                href={`/grape/${g.id}`}
                class="inline-block rounded-full border border-neutral-300 px-3 py-1 text-sm hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition"
              >
                {g.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold">By region</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          regions.map((r) => (
            <li>
              <a
                href={`/region/${r.id}`}
                class="inline-block rounded-full border border-neutral-300 px-3 py-1 text-sm hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition"
              >
                {r.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold">Dishes</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          dishes.map((d) => (
            <li>
              <a
                href={`/dish/${d.id}`}
                class="inline-block rounded-full border border-neutral-300 px-3 py-1 text-sm hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition"
              >
                {d.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>
