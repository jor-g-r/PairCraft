---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntityCover from '../../components/EntityCover.astro';
import WineCard from '../../components/WineCard.astro';
import { regionImage } from '../../lib/region-images';
import { countryEs } from '../../lib/i18n';

export async function getStaticPaths() {
  const regions = await getCollection('regions');
  return regions.map((region) => ({ params: { slug: region.id }, props: { region } }));
}

const { region } = Astro.props;
const { Content } = await render(region);

const band = regionImage(region.id);

const signatureGrapes = await Promise.all(
  region.data.signatureGrapes.map((ref) => getEntry(ref)),
);

const allWines = await getCollection('wines');
const wines = allWines.filter((w) => w.data.region.id === region.id);
---

<Base title={`${region.data.name} — Paircraft`} description={region.data.tagline}>
  <main class="page-shell max-w-3xl">
    <a href="/wines" class="editorial-link mb-6 text-muted" data-i18n="wine.back">All wines</a>
    <EntityCover image={band?.image} alt={band?.alt ?? region.data.name} credit={band?.creditLine}>
      <h1 class="text-balance font-display text-[clamp(2.35rem,6.5vw,3.75rem)] font-normal leading-[1.1]" data-es-value={region.data.nameEs}>{region.data.name}</h1>
      <p class="mt-[0.7rem] max-w-[36rem] font-display text-[1.15rem] italic leading-[1.5]" data-es-value={region.data.taglineEs}>{region.data.tagline}</p>
    </EntityCover>
    <dl class="spec-list mt-7">
      <div><dt data-i18n="region.country">Country</dt><dd data-es-value={countryEs(region.data.country)}>{region.data.country}</dd></div>
    </dl>
    <aside class="tile-shadow mt-8 bg-surface px-[1.15rem] pb-[1.3rem] pt-[1.15rem]">
      <h2 class="text-[0.6875rem] uppercase tracking-[0.06em] text-muted" data-i18n="region.climate">Climate</h2>
      <p class="mt-2 font-display text-[1.2rem] italic leading-[1.45]" data-es-value={region.data.climateEs}>{region.data.climate}</p>
    </aside>

    <article class="mt-8 max-w-[40rem] text-[0.9375rem] font-light leading-[1.7] [&_p+p]:mt-4" data-lang-content="en">
      <Content />
    </article>
    {region.data.bodyEs && <article class="mt-8 hidden max-w-[40rem] text-[0.9375rem] font-light leading-[1.7] [&_p+p]:mt-4" data-lang-content="es" set:html={region.data.bodyEs} />}

    {signatureGrapes.length > 0 && <section class="mt-10">
      <h2 class="mb-[0.7rem] font-display text-[1.3rem] font-normal italic" data-i18n="region.signatureGrapes">Signature grapes</h2>
      <ul class="flex flex-wrap gap-2">{signatureGrapes.map((g) => g && <li><a href={`/grape/${g.id}`} class="type-pill h-[2.1rem] px-4 text-[0.8125rem] normal-case" data-es-value={g.data.nameEs}>{g.data.name}</a></li>)}</ul>
    </section>}

    <section class="mt-12">
      <h2 class="section-title" data-i18n="region.wines">Wines</h2>
      {wines.length === 0 && <p class="mt-4 text-sm font-light text-muted" data-i18n="region.noWines">No wines yet.</p>}
      <ul class="wine-tiles mt-4">{wines.map((wine) => <li><WineCard wine={wine} region={region} /></li>)}</ul>
    </section>
  </main>
</Base>
