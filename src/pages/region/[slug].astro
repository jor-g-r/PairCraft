---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const regions = await getCollection('regions');
  return regions.map((region) => ({ params: { slug: region.id }, props: { region } }));
}

const { region } = Astro.props;
const { Content } = await render(region);

const signatureGrapes = await Promise.all(
  region.data.signatureGrapes.map((ref) => getEntry(ref)),
);

const allWines = await getCollection('wines');
const wines = allWines.filter((w) => w.data.region.id === region.id);
---

<Base title={`${region.data.name} — Paircraft`} description={region.data.tagline}>
  <main class="mx-auto max-w-2xl px-6 py-10 md:py-16">
    <p class="text-sm text-neutral-500">{region.data.country}</p>

    <header class="mt-2">
      <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight">{region.data.name}</h1>
      <p class="mt-2 font-display text-lg italic text-neutral-700">{region.data.tagline}</p>
    </header>

    <p class="mt-6 text-sm text-neutral-600 italic">{region.data.climate}</p>

    <article class="prose prose-neutral mt-8 max-w-none text-neutral-800 leading-relaxed [&_p]:mt-4">
      <Content />
    </article>

    {
      signatureGrapes.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-semibold">Signature grapes</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {signatureGrapes.map(
              (g) =>
                g && (
                  <li>
                    <a
                      href={`/grape/${g.id}`}
                      class="inline-block rounded-full border border-neutral-300 px-3 py-1 text-sm hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition"
                    >
                      {g.data.name}
                    </a>
                  </li>
                ),
            )}
          </ul>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold">Wines</h2>
      {wines.length === 0 && <p class="mt-4 text-neutral-500">No wines yet.</p>}
      <ul class="mt-4 space-y-3">
        {
          wines.map((wine) => (
            <li>
              <a
                href={`/wine/${wine.id}`}
                class="block rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 transition hover:border-neutral-400 hover:bg-white"
              >
                <p class="font-display text-lg font-semibold">
                  {wine.data.name}
                  {wine.data.vintage && (
                    <span class="font-normal text-neutral-500"> {wine.data.vintage}</span>
                  )}
                </p>
                <p class="mt-1 text-sm italic text-neutral-700">{wine.data.tagline}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>
