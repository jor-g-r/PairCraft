---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const regions = await getCollection('regions');
  return regions.map((region) => ({ params: { slug: region.id }, props: { region } }));
}

const { region } = Astro.props;
const { Content } = await render(region);

const signatureGrapes = await Promise.all(
  region.data.signatureGrapes.map((ref) => getEntry(ref)),
);

const allWines = await getCollection('wines');
const wines = allWines.filter((w) => w.data.region.id === region.id);
---

<Base title={`${region.data.name} — Paircraft`} description={region.data.tagline}>
  <main class="page-shell max-w-3xl">
    <a href="/wines" class="editorial-link mb-6 text-muted" data-i18n="wine.back">All wines</a>
    <p class="text-sm text-neutral-500">{region.data.country}</p>

    <header class="mt-2">
      <h1 class="page-title">{region.data.name}</h1>
      <p class="mt-2 font-display text-lg italic text-neutral-700" data-es-value={region.data.taglineEs}>{region.data.tagline}</p>
    </header>

    <p class="mt-6 text-sm text-neutral-600 italic">{region.data.climate}</p>

    <article class="prose prose-neutral mt-8 max-w-none text-neutral-800 leading-relaxed [&_p]:mt-4" data-lang-content="en">
      <Content />
    </article>
    {
      region.data.bodyEs && (
        <article class="prose prose-neutral mt-8 max-w-none text-neutral-800 leading-relaxed [&_p]:mt-4 hidden" data-lang-content="es" set:html={region.data.bodyEs} />
      )
    }

    {
      signatureGrapes.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display text-2xl font-semibold" data-i18n="region.signatureGrapes">Signature grapes</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {signatureGrapes.map(
              (g) =>
                g && (
                  <li>
                    <a
                      href={`/grape/${g.id}`}
                      class="inline-flex min-h-11 items-center rounded-full border border-rule px-4 py-2 text-sm hover:border-ink transition"
                    >
                      {g.data.name}
                    </a>
                  </li>
                ),
            )}
          </ul>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="section-title" data-i18n="region.wines">Wines</h2>
      {wines.length === 0 && <p class="mt-4 text-neutral-500" data-i18n="region.noWines">No wines yet.</p>}
      <ul class="mt-4 space-y-3">
        {
          wines.map((wine) => (
            <li>
              <a
                href={`/wine/${wine.id}`}
                class="block border-t border-rule py-5 transition hover:border-ink"
              >
                <p class="font-display text-lg font-semibold">
                  {wine.data.name}
                  {wine.data.vintage && (
                    <span class="font-normal text-neutral-500"> {wine.data.vintage}</span>
                  )}
                </p>
                <p class="mt-1 text-sm italic text-neutral-700" data-es-value={wine.data.taglineEs}>{wine.data.tagline}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>
