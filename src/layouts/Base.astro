---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import LangToggle from '../components/LangToggle.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import brandMark from '../../public/favicon.svg?raw';
import { UI_STRINGS } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const navigation = [
  { href: '/wines', label: 'Wines', key: 'nav.wines', active: Astro.url.pathname.startsWith('/wine') },
  { href: '/dishes', label: 'Dishes', key: 'nav.dishes', active: Astro.url.pathname.startsWith('/dish') },
  { href: '/pair', label: 'Find a pairing', key: 'nav.pair', active: Astro.url.pathname === '/pair' },
  { href: '/about', label: 'About', key: 'nav.about', active: Astro.url.pathname === '/about' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        let preference;
        try { preference = document.cookie.match(/(?:^|; )pc_theme=(light|dark)(?:;|$)/)?.[1] || localStorage.getItem('pc_theme'); } catch {}
        const dark = preference === 'dark' || (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#1e1e1e' : '#ffffff');
      })();
    </script>
    <meta name="robots" content="noindex, nofollow" />
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <script type="application/json" id="i18n-dict" set:html={JSON.stringify(UI_STRINGS)}></script>
  </head>
  <body class="min-h-dvh bg-white text-neutral-900 antialiased font-sans">
    <script is:inline>
      (function () {
        function getLang() {
          try {
            const match = document.cookie.match(/(?:^|; )pc_lang=([^;]+)/);
            if (match) return match[1];
          } catch (e) {}
          try {
            const ls = localStorage.getItem('pc_lang');
            if (ls) return ls;
          } catch (e) {}
          return 'en';
        }

        function applyI18n() {
          const locale = getLang();
          document.documentElement.lang = locale;

          const dictEl = document.getElementById('i18n-dict');
          const dict = dictEl ? JSON.parse(dictEl.textContent || '{}') : {};

          // Simple data-i18n text swap
          document.querySelectorAll('[data-i18n]').forEach((el) => {
            const key = el.getAttribute('data-i18n');
            if (!key) return;
            const val = dict[key]?.[locale];
            if (val) el.textContent = val;
          });

          // Placeholders on inputs
          document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
            const key = el.getAttribute('data-i18n-placeholder');
            if (!key) return;
            const val = dict[key]?.[locale];
            if (val) el.setAttribute('placeholder', val);
          });

          // Tier badge labels
          document.querySelectorAll('[data-i18n-tier]').forEach((el) => {
            const tier = el.getAttribute('data-i18n-tier');
            if (!tier) return;
            const key = 'tier.' + tier;
            const val = dict[key]?.[locale];
            if (val) el.textContent = val;
          });

          // Mode labels
          document.querySelectorAll('[data-i18n-mode]').forEach((el) => {
            const mode = el.getAttribute('data-i18n-mode');
            if (!mode) return;
            const key = 'mode.' + mode;
            const val = dict[key]?.[locale];
            if (val) el.textContent = val;
          });

          // Search type badges
          document.querySelectorAll('[data-i18n-search-type]').forEach((el) => {
            const type = el.getAttribute('data-i18n-search-type');
            if (!type) return;
            const key = 'home.searchType' + type.charAt(0).toUpperCase() + type.slice(1);
            const val = dict[key]?.[locale];
            if (val) el.textContent = val;
          });

          // Editorial content: data-es-value swaps textContent
          document.querySelectorAll('[data-es-value]').forEach((el) => {
            const esVal = el.getAttribute('data-es-value');
            if (!esVal) return;
            if (locale === 'es') {
              if (!el.hasAttribute('data-en-value')) el.setAttribute('data-en-value', el.textContent || '');
              el.textContent = esVal;
            } else {
              const enVal = el.getAttribute('data-en-value');
              if (enVal) el.textContent = enVal;
            }
          });

          // Editorial blocks: data-lang-content shows/hides
          document.querySelectorAll('[data-lang-content]').forEach((el) => {
            const lang = el.getAttribute('data-lang-content');
            if (!lang) return;
            el.classList.toggle('hidden', lang !== locale);
          });

          // Update lang toggle visual state
          const toggle = document.querySelector('.lang-toggle-wrap');
          if (toggle) toggle.setAttribute('data-active', locale);

          // Update toggle button aria-pressed
          document.querySelectorAll('.lang-toggle-btn').forEach((btn) => {
            const isActive = btn.getAttribute('data-lang') === locale;
            btn.setAttribute('aria-pressed', String(isActive));
          });
        }

        applyI18n();
        document.addEventListener('astro:page-load', applyI18n);
      })();
    </script>

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:p-4" data-i18n="nav.skip">Skip to content</a>
    <header class="sticky top-0 z-30 border-b border-rule bg-paper">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-5 py-3 sm:px-8">
        <a
          href="/"
          class="inline-flex min-w-0 items-start gap-2.5 text-neutral-900 transition-colors hover:text-neutral-600"
        >
          <span class="brand-mark h-9 w-9 shrink-0" aria-hidden="true" set:html={brandMark} />
          <span class="min-w-0 pt-1 font-display text-2xl font-semibold leading-none tracking-tight sm:text-3xl">
            Paircraft
          </span>
        </a>
        <div class="flex shrink-0 items-center gap-2"><ThemeToggle /><LangToggle /></div>
      </div>
      <nav aria-label="Main navigation" class="mx-auto flex max-w-5xl items-center justify-between gap-1 px-5 sm:justify-start sm:gap-8 sm:px-8">
        {navigation.map((item) => <a href={item.href} aria-current={item.active ? 'page' : undefined} class:list={['flex min-h-11 items-center border-b-2 px-0.5 text-xs font-semibold sm:text-sm', item.active ? 'border-ink text-ink' : 'border-transparent text-muted hover:text-ink']} data-i18n={item.key}>{item.label}</a>)}
      </nav>
    </header>
    <div id="main-content" tabindex="-1"><slot /></div>

    <footer class="mt-24 border-t border-neutral-200/80">
      <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8 md:py-14">
        <div class="flex flex-col gap-3 text-sm text-neutral-500 md:flex-row md:items-baseline md:justify-between">
          <p class="font-display italic" data-i18n="site.tagline">"Drink this with that."</p>
          <p class="flex flex-wrap items-baseline gap-x-2">
            <span data-i18n="site.builtBy">Built by</span>
            <a
              href="https://portfolio-jorge-rondon.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-baseline gap-1 hover:text-neutral-900 underline-offset-4 hover:underline"
            >
              <span>Jorge Rondón</span>
              <svg
                class="h-3 w-3 self-center"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7"></path>
                <path d="M7 7h10v10"></path>
              </svg>
            </a>
            <span class="text-neutral-300">·</span>
            <span>2026</span>
          </p>
        </div>
      </div>
    </footer>

    <script>
      function syncTheme(doc: Document = document) {
        let preference: string | null | undefined;
        try { preference = document.cookie.match(/(?:^|; )pc_theme=(light|dark)(?:;|$)/)?.[1] || localStorage.getItem('pc_theme'); } catch {}
        const dark = preference === 'dark' || (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        doc.documentElement.classList.toggle('dark', dark);
        doc.querySelector('#theme-toggle')?.setAttribute('aria-pressed', String(dark));
        doc.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#1e1e1e' : '#ffffff');
      }
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('#theme-toggle')) return;
        const theme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        try { localStorage.setItem('pc_theme', theme); } catch {}
        document.cookie = `pc_theme=${theme}; path=/; max-age=31536000; samesite=lax`;
        syncTheme();
      });
      document.addEventListener('astro:before-swap', (event) => syncTheme(event.newDocument));
      document.addEventListener('astro:page-load', () => syncTheme());
      function restoreCatalogLinks() {
        try {
          const saved = sessionStorage.getItem('pc_catalog_query');
          if (saved) document.querySelectorAll<HTMLAnchorElement>('[data-catalog-return]').forEach((link) => link.href = `/wines?${new URLSearchParams(saved)}`);
        } catch {}
      }
      document.addEventListener('astro:page-load', restoreCatalogLinks);
      restoreCatalogLinks();
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => syncTheme());
      syncTheme();
    </script>

    <script is:inline>
      // Scroll-reveal — promote elements with class="reveal" once they enter
      // the viewport. Runs on each page (re-attaches after view-transitions
      // navigate via astro:page-load).
      function initReveals() {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveals);

      function initLangSwitch() {
        document.querySelectorAll('.lang-toggle-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const lang = btn.getAttribute('data-lang');
            if (!lang) return;
            try {
              localStorage.setItem('pc_lang', lang);
            } catch (e) {}
            document.cookie = 'pc_lang=' + lang + '; path=/; max-age=31536000; samesite=lax';
            window.location.reload();
          });
        });
      }
      initLangSwitch();
      document.addEventListener('astro:page-load', initLangSwitch);
    </script>
  </body>
</html>
<style is:global>
  .brand-mark svg { width: 100%; height: 100%; }
  .dark .brand-mark path:nth-of-type(2) { fill: #fafafa; }
</style>
