---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="robots" content="noindex, nofollow" />
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-white text-neutral-900 antialiased font-sans">
    <header class="sticky top-0 z-10 border-b border-neutral-200/60 bg-white/85 backdrop-blur supports-[backdrop-filter]:bg-white/70">
      <div class="mx-auto max-w-2xl px-6 py-3">
        <a
          href="/"
          class="font-display text-xl font-bold tracking-tight hover:text-neutral-600 transition-colors"
        >
          Paircraft
        </a>
      </div>
    </header>
    <slot />

    <footer class="mt-24 border-t border-neutral-200/80">
      <div class="mx-auto max-w-2xl px-6 py-10 md:py-14">
        <div class="flex flex-col gap-3 text-sm text-neutral-500 md:flex-row md:items-baseline md:justify-between">
          <p class="font-display italic">"Drink this with that."</p>
          <p class="flex flex-wrap items-baseline gap-x-2">
            <span>Built by</span>
            <a
              href="https://portfolio-jorge-rondon.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-baseline gap-1 hover:text-neutral-900 underline-offset-4 hover:underline"
            >
              <span>Jorge Rondón</span>
              <svg
                class="h-3 w-3 self-center"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7"></path>
                <path d="M7 7h10v10"></path>
              </svg>
            </a>
            <span class="text-neutral-300">·</span>
            <span>2026</span>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Scroll-reveal — promote elements with class="reveal" once they enter
      // the viewport. Runs on each page (re-attaches after view-transitions
      // navigate via astro:page-load).
      function initReveals() {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveals);
    </script>
  </body>
</html>
